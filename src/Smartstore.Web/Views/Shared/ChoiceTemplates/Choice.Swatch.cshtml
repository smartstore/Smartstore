@model ChoiceModel

@{
    // TODO: Default swatch size for bundle items should be "Small"
}

@{
    var controlId = Model.BuildControlId();
    var items = Model.Values ?? new List<ChoiceItemModel>();
    var srLabelTemplate = T("Aria.Label.Choice");
    var canUseCardLayout = Model.CanUseCardLayout;

    // TEST
    // if (canUseCardLayout)
    // {
    //     Model.SwatchSize = SwatchSize.XXLarge;
    //     Model.SwatchShape = SwatchShape.Rounded;
    //     Model.SwatchAspectRatio = 0.75m;
    //     Model.ShowValueNameInSwatch = true;
    //     Model.SwatchPriceDisplay = SwatchPriceDisplayMode.FinalPrice;
    // }
    // TEST

    var useCardLayout = Model.UseCardLayout;

    var sizeClass = Model.SwatchSize.ToCssToken();
    var shapeClass = Model.EffectiveSwatchShape.ToCssToken();

    var groupClass = $"swatch-group swatch-group-{sizeClass} swatch-shape-{shapeClass}";
    if (canUseCardLayout)
    {
        groupClass += " swatch-group-fixed";
    }
    if (useCardLayout)
    {
        groupClass += " swatch-group-cards";
    }
}

<div class="swatches" 
     id="swatches-@Model.Id" 
     role="radiogroup"      
     data-manualselect="true"
     data-swatch-size="@sizeClass"
     data-swatch-shape="@shapeClass"
     data-media-card="@useCardLayout.ToString().ToLowerInvariant()"
     aria-orientation="horizontal"  
     attr-aria-required='(Model.IsRequired, "true")'>
    <ul class="@groupClass" style="--swatch-aspect-ratio: @Model.EffectiveSwatchAspectRatio.ToStringInvariant()">
        @foreach (var item in items)
        {
            var css = item.GetSwatchStyle();
            var label = item.GetAccessibleLabel();
            var hasColor = item.HasColor;
            var hasImage = item.HasImage;
            var isDark = hasColor && ImagingHelper.GetPerceivedBrightness(item.Color) < 200;

            // TEST
            //item.IsUnavailable = label.Contains("a") || hasImage;
            // TEST

            var swatchClass = "swatch"
                + (item.IsPreSelected ? " selected" : null)
                + (isDark ? " dark" : null)
                + (item.IsDisabled ? " disabled" : item.IsUnavailable ? " unavailable" : null);

            var elementClass = "swatch-element"
                + (useCardLayout ? null : hasImage ? " swatch-image" : hasColor ? " swatch-color" : null);

            var swatchPrice = item.GetSwatchPriceText(Model.SwatchPriceDisplay);

            // TEST
            //swatchPrice ??= "199,59 €";
            // TEST

            <li class="@swatchClass" data-swatch-value="@item.GetSwatchDisplayName()">
                <input type="radio"
                       class="swatch-input"
                       id="@(controlId)_@(item.Id)"
                       name="@(controlId)"
                       value="@item.Id"
                       aria-label="@srLabelTemplate.Value.FormatInvariant(Model.Name, label)"
                       attr-checked='(item.IsPreSelected, "checked")'
                       attr-disabled='(item.IsDisabled, "disabled")' />

                <label class="swatch-label" for="@(controlId)_@(item.Id)">
                    <span class="swatch-content">
                        @if (useCardLayout)
                        {
                            <span class="@elementClass swatch-card">
                                <span class="swatch-media swatch-visual@(hasImage ? " swatch-image" : " swatch-color")" attr-style="(css.HasValue(), css)"></span>
                                <span class="swatch-details">
                                    <span sm-if="Model.ShowValueNameInSwatch" class="swatch-value">@item.Name</span>
                                    <span sm-if="Model.SwatchPriceDisplay != SwatchPriceDisplayMode.None" class="swatch-price text-truncate">@swatchPrice</span>
                                    <span sm-if="item.UnavailableReason.HasValue()" class="swatch-status">@item.UnavailableReason</span>
                                </span>
                            </span>
                        }
                        else
                        {
                            <span class="@elementClass swatch-visual" attr-style="(css.HasValue(), css)">
                                <span sm-if="!css.HasValue()" class="swatch-value">@item.Name</span>
                            </span>
                        }
                    </span>
                </label>
            </li>
        }
    </ul>
</div>
