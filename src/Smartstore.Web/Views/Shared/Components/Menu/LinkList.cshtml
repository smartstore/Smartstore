@using Smartstore.Web.Rendering.Menus
@using Smartstore.Core.Content.Menus

@model MenuModel

@{
    var root = Model.Root;
    if (root == null)
    {
        return;
    }

    var isFirst = true;
    var hasIcons = root.Children.Any(x => (Model.IconOptions == null || (x.Value.Visible && !x.Value.IsGroupHeader)) && Model.GetIcon(x.Value).HasValue());
    var hasImages = root.Children.Any(x => (Model.IconOptions == null || (x.Value.Visible && !x.Value.IsGroupHeader)) && x.Value.ImageUrl.HasValue());
}

<div class="cms-menu cms-menu-linklist" data-menu-name="@(Model.Name?.ToLower())">
    <ul class="list-unstyled">
        @foreach (var node in root.Children)
        {
            var item = node.Value;
            if (!item.Visible)
            {
                continue;
            }

            var itemText = node.GetItemText(T);
            var itemUrl = item.GenerateUrl(this.ViewContext);
            var icon = Model.GetIcon(item);

            if (item.IsGroupHeader)
            {
                if (!isFirst)
                {
                    <li><hr class="my-2" /></li>
                }
                if (itemText.HasValue() && item.Text != "[SKIP]")
                {
                    <li class="menu-header h5 mt-2">@itemText</li>
                }
                isFirst = false;
                continue;
            }

            var attrs = item.GetCombinedAttributes().PrependCssClass("menu-link");
        
            <li>
                <a href="@itemUrl" attrs="attrs">
                    @if (Model.IconOptions != null && item.ImageUrl.HasValue() && !icon.HasValue())
                    {
                        <img class="icon" src="@Url.Content(item.ImageUrl)" alt="@itemText" />
                    }
                    else if (hasIcons)
                    {
                        <icon sm-if="Model.IconOptions == null || icon.HasValue()" name="@(Model.IconOptions == null ? item.Icon.NullEmpty() ?? "arrow-right" : icon)" class="icon-fw" attr-class='@(item.IconClass.HasValue(), item.IconClass)' />
                    }
                    else if (hasImages && item.ImageUrl.HasValue())
                    {
                        <img class="icon" src="@Url.Content(item.ImageUrl)" alt="@itemText" />
                    }
                    else if (hasImages && Model.IconOptions == null)
                    {
                        <icon name="arrow-right" class="icon-fw" />
                    }

                    <span sm-language-attributes-for="item">@itemText</span>
                </a>
            </li>

            isFirst = false;
        }
    </ul>
</div>