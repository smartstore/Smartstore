@using Smartstore.Net

@model dynamic

@{
    Layout = null;

    var themes = (IList<SelectListItem>)ViewBag.Themes;
    var stores = (IList<SelectListItem>)ViewBag.Stores;
    var currentTheme = themes.FirstOrDefault(x => x.Selected) ?? themes.FirstOrDefault();
    var currentStore = stores.FirstOrDefault(x => x.Selected) ?? stores.FirstOrDefault();
    var disableApply = (bool)ViewBag.DisableApply;
}

<form id="previewmode" asp-controller="Theme" asp-action="PreviewTool" asp-area="Admin" method="post" class="floating-toolbar floating-toolbar-autofade rounded-sm">
    <input type="hidden" name="returnUrl" value="@Context.Request.RawUrl()" />
    <input type="hidden" name="theme" value="@currentTheme?.Value" />
    <input type="hidden" name="storeId" value="@currentStore?.Value" />

    <button type="button" class="btn btn-secondary btn-plain btn-xs fwn btn-icon floating-toolbar-toggle" title="@T("Admin.Header.CollapseNavigation.Short")" data-collapse-title="@T("Admin.Header.CollapseNavigation.Short")" data-expand-title="@T("Admin.Configuration.Themes.PreviewMode")" aria-expanded="true" aria-controls="previewmode">
        <icon name="hi:arrow-left-05/sr" />
    </button>

    <span class="floating-toolbar-label">@T("Admin.Configuration.Themes.PreviewMode"):</span>

    <div class="dropup">
        <button id="preview-theme" type="button" style="max-width: 200px" class="btn btn-secondary btn-plain btn-xs fwn dropdown-toggle" data-toggle="dropdown" aria-expanded="false" title="@T("Admin.Configuration.Themes.Theme")">
            <icon name="hi:paint-board/sr" />
            <span class="text-truncate">@currentTheme?.Text</span>
        </button>
        <div class="dropdown-menu" aria-labelledby="preview-theme">
            @foreach (var theme in themes)
            {
                <button type="button" class="dropdown-item" attr-class='(theme.Selected, "active")' attr-disabled='(theme.Disabled, "disabled")' data-preview-field="theme" data-value="@theme.Value">@theme.Text</button>
            }
        </div>
    </div>

    <div class="dropup">
        <button id="preview-store" type="button" style="max-width: 200px" class="btn btn-secondary btn-plain btn-xs fwn dropdown-toggle" data-toggle="dropdown" aria-expanded="false" title="@T("Admin.Common.Store")">
            <icon name="hi:store-01/sr" />
            <span class="text-truncate">@currentStore?.Text</span>
        </button>
        <div class="dropdown-menu" aria-labelledby="preview-store">
            @foreach (var store in stores)
            {
                <button type="button" class="dropdown-item" attr-class='(store.Selected, "active")' attr-disabled='(store.Disabled, "disabled")' data-preview-field="storeId" data-value="@store.Value">@store.Text</button>
            }
        </div>
    </div>

    <div class="vr" aria-hidden="true"></div>

    <button type="submit" name="PreviewMode.Exit" value="@T("Admin.Configuration.Themes.ExitPreviewMode")" title="@T("Admin.Configuration.Themes.ExitPreviewMode")" class="btn btn-secondary btn-plain btn-xs fwn">
        <icon name="hi:view-off-slash/sr" />
        <span>@T("Common.Exit")</span>
    </button>
    <button type="submit" name="PreviewMode.Apply" value="@T("Common.Apply")" class="btn btn-primary btn-flat btn-xs" attr-disabled='(disableApply, "disabled")'>
        <icon name="hi:check/sr" />
        <span>@T("Common.Apply")</span>
    </button>
</form>

<script>
    $(function () {
        $('#previewmode').on('click', '[data-preview-field]', function () {
            $(this.form).find('input[name="' + $(this).attr('data-preview-field') + '"]').val($(this).attr('data-value'));
            this.form.submit();
        });
    });
</script>
