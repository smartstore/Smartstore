<div class="card card-body text-center d-flex" style="border-style: dashed;">
    <div class="fs-h3 mt-3 mb-2 text-uppercase">
        @T("Common.Or")
    </div>
    <div class="fs-display-3 text-muted">
        <icon name="plus"  />
    </div>
    <div class="mt-auto">
        <button id="add-address-button"
                type="button" 
                class="btn btn-primary btn-block add-new-address align-self-end" 
                aria-controls="cnt-add-new-address" 
                aria-expanded="false">
            <span>@T("Admin.Customers.Customers.Addresses.AddNew")</span>
            <icon name="chevron-right"  aria-hidden="true" />
        </button>
    </div>
</div>

