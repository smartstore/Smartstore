@*
    PROTOTYPE ONLY.

    Lets you switch the choice box display options in the browser while the entity columns
    do not exist yet. Writes a "sm-box-playground" cookie which Choice.Box.cshtml reads.
    Delete this file, its include in Product.Offer.cshtml and the marked block in
    Choice.Box.cshtml once the options are persisted on ProductVariantAttribute.
*@

<div class="pd-box-playground card border-warning mb-3" id="pd-box-playground">
    <div class="card-body py-2 px-3">
        <div class="d-flex flex-wrap align-items-center" style="gap: 0.75rem">
            <span class="badge badge-warning">Prototype</span>

            <label class="mb-0 small">
                Size
                <select class="form-control form-control-sm d-inline-block w-auto ml-1" data-proto="size">
                    <option value="XSmall">xs &ndash; 24</option>
                    <option value="Small">sm &ndash; 36</option>
                    <option value="Medium">md &ndash; 46</option>
                    <option value="Large">lg &ndash; 64</option>
                    <option value="XLarge">xl &ndash; 96</option>
                    <option value="XXLarge">xxl &ndash; 128</option>
                </select>
            </label>

            <label class="mb-0 small">
                Shape
                <select class="form-control form-control-sm d-inline-block w-auto ml-1" data-proto="shape">
                    <option value="Rounded">Rounded</option>
                    <option value="Rect">Rect</option>
                    <option value="Circle">Circle</option>
                </select>
            </label>

            <label class="mb-0 small">
                Price
                <select class="form-control form-control-sm d-inline-block w-auto ml-1" data-proto="price">
                    <option value="None">None</option>
                    <option value="PriceAdjustment">Adjustment</option>
                    <option value="FinalPrice">Final price</option>
                </select>
            </label>

            <label class="mb-0 small">
                <input type="checkbox" data-proto="name" /> Value name in box
            </label>

            <button type="button" class="btn btn-sm btn-outline-secondary" data-proto-reset>Reset</button>
        </div>
        <div class="small text-muted mt-1">
            Portrait needs every value to have a color or image, otherwise the price drops into the compact chip.
            Circle falls back to rounded as soon as a second line appears. "Final price" still renders the
            adjustment &ndash; price calculation is not part of this prototype.
        </div>
    </div>
</div>

<script sm-target-zone="scripts" data-origin="pd-box-playground">
    $(function () {
        var COOKIE = 'sm-box-playground';
        var panel = $('#pd-box-playground');

        function read() {
            var match = document.cookie.match(new RegExp('(?:^|; )' + COOKIE + '=([^;]*)'));
            var result = {};

            if (match) {
                decodeURIComponent(match[1]).split('|').forEach(function (pair) {
                    var kv = pair.split(':');
                    if (kv.length === 2) {
                        result[kv[0]] = kv[1];
                    }
                });
            }

            return result;
        }

        function write() {
            var parts = [];

            panel.find('[data-proto]').each(function () {
                var val = this.type === 'checkbox' ? (this.checked ? '1' : '0') : this.value;
                parts.push($(this).data('proto') + ':' + val);
            });

            document.cookie = COOKIE + '=' + encodeURIComponent(parts.join('|')) + ';path=/;max-age=86400';
            location.reload();
        }

        // Restore panel state from the cookie.
        var current = read();
        panel.find('[data-proto]').each(function () {
            var val = current[$(this).data('proto')];
            if (val === undefined) {
                return;
            }

            if (this.type === 'checkbox') {
                this.checked = val === '1';
            }
            else {
                this.value = val;
            }
        });

        panel.on('change', '[data-proto]', write);

        panel.on('click', '[data-proto-reset]', function () {
            document.cookie = COOKIE + '=;path=/;max-age=0';
            location.reload();
        });
    });
</script>
