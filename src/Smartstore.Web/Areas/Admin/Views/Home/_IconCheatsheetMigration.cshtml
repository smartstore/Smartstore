    {
        ["archive"] = "Shared",
        ["arrow-left"] = "Shared",
        ["arrow-right"] = "Shared",
        ["arrow-turn-up"] = "Shared",
        ["award"] = "Shared",
        ["basket"] = "Shared",
        ["braces"] = "Shared",
        ["building"] = "Shared",
        ["envelope-open-text"] = "Shared",
        ["github"] = "Shared",
        ["grip"] = "Shared",
        ["grip-vertical"] = "Shared",
        ["home"] = "Shared",
        ["instagram"] = "Shared",
        ["linkedin"] = "Shared",
        ["mail-forward"] = "Shared",
        ["move"] = "Shared",
        ["reply"] = "Shared",
        ["share-square"] = "Shared",
        ["twitter-x"] = "Shared",
        ["youtube"] = "Shared",
    };

    // Resolve the kit once, then order by kit priority and concept name.
    var orderedMappings = mappings.Select(mapping =>
    {
        var aliases = mapping.FontAwesome.Split('|', StringSplitOptions.RemoveEmptyEntries)
            .GroupBy(x => x[(x.IndexOf(" fa-", StringComparison.Ordinal) + 4)..]).ToArray();
        var bootstrapNames = mapping.Bootstrap.Split('|', StringSplitOptions.RemoveEmptyEntries);
        var sourceGroups = aliases.Select(x => Model["fa:" + x.Key].Group)
            .Concat(bootstrapNames.Select(x => Model["bi:" + x].Group)).ToHashSet();
        // A concept is shared even when separate FA/BI names supply the two areas.
        var kit = sourceGroups.Contains("Shared") || (sourceGroups.Contains("Frontend") && sourceGroups.Contains("Backend"))
            ? "Shared"
            : sourceGroups.Contains("Frontend") ? "Frontend" : "Backend";
        if (kitOverrides.TryGetValue(mapping.Concept, out var selectedKit))
        {
            kit = selectedKit;
        }

        return new { Mapping = mapping, Aliases = aliases, BootstrapNames = bootstrapNames, Kit = kit };
    })
    .OrderBy(x => x.Kit == "Shared" ? 0 : x.Kit == "Frontend" ? 1 : 2)
    .ThenBy(x => x.Mapping.Concept, StringComparer.OrdinalIgnoreCase);
}

<section class="mb-4" data-inventory-group aria-labelledby="icon-migration-title"
         data-icon-preview-url="@Url.Action("IconCheatsheetPreview", "Home", new { area = "Admin" })">
    <details class="mapped-icons-details" open>
        <summary class="mb-3"><h3 id="icon-migration-title" class="h5 d-inline">Migration <small class="text-muted">(@mappings.Length)</small></h3></summary>
        <p class="small text-muted">
            Flat mapping proposals across all three inventory groups, using familiar names such as upload, send and refresh.
            Explicit naming conventions: trash for the bin, check for the checkmark and disk for the floppy disk.
            Filled and outline variants share a concept. HI SVG and font are shown side by side.
            These proposals do not change the library mappings.
        </p>
        <div class="table-responsive">
            <table class="table table-hover comparison-table">
                <thead>
                    <tr>
                        <th scope="col" class="text-center">FA / BI</th>
                        <th scope="col" class="text-center">HI / HI Font</th>
                        <th scope="col">Proposed concept</th>
                        <th scope="col">Proposed Kit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in orderedMappings)
                    {
                        var mapping = row.Mapping;
                        var aliases = row.Aliases;
                        var bootstrapNames = row.BootstrapNames;
                        var kit = row.Kit;
                        var fontName = mapping.Huge == "sorting-1-9" ? "sorting-one-9" : mapping.Huge;
                        <tr data-migration-key="@mapping.Concept" data-icon-search="@($"Migration {mapping.Concept} {mapping.FontAwesome} {mapping.Bootstrap} {mapping.Huge} {kit}")">
                            <td class="text-center">
                                <div class="migration-source-icons">
                                    @if (mapping.FontAwesome.Length > 0)
                                    {
                                        // Preserve each source alias while sharing its label across FA styles.
                                        foreach (var alias in aliases)
                                        {
                                            var variants = string.Join("/", alias.Select(x => x[..x.IndexOf(' ')]));
                                            <div>
                                                <span class="inventory-icon-row">
                                                    @foreach (var cssClass in alias)
                                                    {
                                                        <span class="comparison-icon" aria-hidden="true" title="@cssClass"><i class="@cssClass comparison-icon-fa"></i></span>
                                                    }
                                                </span>
                                                <code class="icon-name">@alias.Key @variants <strong>@Model["fa:" + alias.Key].Uses</strong></code>
                                            </div>
                                        }
                                    }
                                    @if (mapping.Bootstrap.Length > 0)
                                    {
                                        foreach (var name in bootstrapNames)
                                        {
                                            <div>
                                                <span class="comparison-icon" aria-hidden="true" title="@($"BI {name}")"><bootstrap-icon name="@name" /></span>
                                                <code class="icon-name">@name bi <strong>@Model["bi:" + name].Uses</strong></code>
                                            </div>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="inventory-icon-row">
                                    <span class="comparison-icon" aria-hidden="true" title="HI SVG" data-migration-svg><icon name="@(mapping.Huge + "!")" library="hi" variant="stroke-rounded" /></span>
                                    <span class="comparison-icon" aria-hidden="true" title="HI Font" data-migration-font><i class="hgi-stroke hgi-@fontName"></i></span>
                                </span>
                                <input type="text" class="form-control form-control-sm migration-hi-name mt-2" size="24"
                                       value="@mapping.Huge" data-migration-hi data-valid-name="@mapping.Huge"
                                       aria-label="@($"HI proposal for {mapping.Concept}")" aria-invalid="false"
                                       aria-describedby="@($"hi-error-{mapping.Concept}")" autocomplete="off" spellcheck="false" />
                                <div id="@($"hi-error-{mapping.Concept}")" class="invalid-feedback" aria-live="polite" data-migration-hi-error></div>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm w-auto" size="24"
                                       value="@mapping.Concept" data-migration-concept
                                       aria-label="@($"Proposed concept for {mapping.Concept}")" autocomplete="off" spellcheck="false" />
                                @if (mapping.Note.Length > 0)
                                {
                                    <div class="small text-muted mt-1">@mapping.Note</div>
                                }
                            </td>
                            <td>
                                <select class="form-control form-control-sm noskin w-auto" data-migration-kit
                                        aria-label="@($"Proposed Kit for {mapping.Concept}")">
                                    <option value="Shared" selected="@(kit == "Shared")">Shared</option>
                                    <option value="Frontend" selected="@(kit == "Frontend")">Frontend</option>
                                    <option value="Backend" selected="@(kit == "Backend")">Backend</option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
</section>

<script sm-target-zone="scripts" data-origin="IconCheatsheetMigration">
    (() => {
        const root = document.querySelector('[data-icon-preview-url]');
        const requests = new WeakMap();

        function showError(input, message) {
            input.classList.toggle('is-invalid', !!message);
            input.setAttribute('aria-invalid', String(!!message));
            input.parentElement.querySelector('[data-migration-hi-error]').textContent = message;
        }

        async function updatePreview(input) {
            const name = input.value.trim();
            input.value = name;
            if (requests.has(input)) return;
            if (name === input.dataset.validName) {
                showError(input, '');
                return;
            }
            if (!/^[a-zA-Z0-9-]{1,128}$/.test(name)) {
                showError(input, 'Enter a valid HI icon name.');
                return;
            }

            const request = new AbortController();
            requests.set(input, request);
            input.setAttribute('aria-busy', 'true');
            const row = input.closest('[data-migration-key]');
            try {
                const url = new URL(root.dataset.iconPreviewUrl, location.href);
                url.searchParams.set('name', name);
                const response = await fetch(url, { signal: request.signal });
                if (response.status === 404) {
                    throw new Error('Preview endpoint unavailable. Rebuild and restart the application.');
                }
                if (!response.ok) throw new Error(`Preview could not be loaded (HTTP ${response.status}).`);
                const documentPreview = new DOMParser().parseFromString(await response.text(), 'text/html');
                const svg = documentPreview.body.firstElementChild;
                if (!svg || svg.localName !== 'svg' || !svg.hasAttribute('data-icon')) {
                    throw new Error('HI icon not found.');
                }

                // Check the loaded font stylesheet before replacing either preview.
                const fontName = name === 'sorting-1-9' ? 'sorting-one-9' : name;
                const font = document.createElement('i');
                font.className = `hgi-stroke hgi-${fontName}`;
                font.style.display = 'none';
                const fontPreview = row.querySelector('[data-migration-font]');
                fontPreview.append(font);
                const content = getComputedStyle(font, '::before').content;
                font.remove();
                font.style.removeProperty('display');
                if (!content || ['none', 'normal', '""', "''"].includes(content)) {
                    throw new Error('HI font icon unavailable. Check the name and font stylesheet.');
                }

                // An edit during the request must never replace the newer selection.
                if (request.signal.aborted || input.value.trim() !== name) return;
                row.querySelector('[data-migration-svg]').replaceChildren(svg);
                fontPreview.replaceChildren(font);
                input.dataset.validName = name;
                showError(input, '');
            }
            catch (error) {
                if (!request.signal.aborted) showError(input, error.message);
            }
            finally {
                if (requests.get(input) === request) {
                    requests.delete(input);
                    input.removeAttribute('aria-busy');
                }
            }
        }

        root.addEventListener('input', event => {
            const input = event.target.closest('[data-migration-hi]');
            if (!input) return;
            requests.get(input)?.abort();
            requests.delete(input);
            input.removeAttribute('aria-busy');
            showError(input, '');
        });
        root.addEventListener('focusout', event => {
            if (event.target.matches('[data-migration-hi]')) updatePreview(event.target);
        });
        root.addEventListener('keydown', event => {
            if (event.key === 'Enter' && event.target.matches('[data-migration-hi]')) {
                event.preventDefault();
                updatePreview(event.target);
            }
        });
    })();
</script>
