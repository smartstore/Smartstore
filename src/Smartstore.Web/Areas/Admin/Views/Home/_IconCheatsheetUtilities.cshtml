        ]),
        ("Animation variables", "Finite examples finish after three iterations. Reload the page to replay them.", false,
        [
            ("Duration: 4s", "hi:settings-01!@stroke-rounded", "icon-3x icon-spin", "--icon-animation-duration: 4s;"),
            ("Shared duration", "hi:settings-01!@stroke-rounded", "icon-3x icon-spin", "--animation-duration: 4s;"),
            ("Alternate", "hi:settings-01!@stroke-rounded", "icon-3x icon-spin", "--icon-animation-direction: alternate;"),
            ("Four steps", "hi:settings-01!@stroke-rounded", "icon-3x icon-spin", "--icon-animation-timing: steps(4);"),
            ("Delay + finite count", "hi:settings-01!@stroke-rounded", "icon-3x icon-spin", "--icon-animation-delay: 2s; --icon-animation-iteration-count: 3;"),
            ("Paused", "hi:settings-01!@stroke-rounded", "icon-3x icon-spin", "--icon-animation-play-state: paused;"),
            ("icon-beat", "hi:favourite!@stroke-rounded", "icon-3x icon-beat", "--icon-beat-scale: 1.6;"),
            ("icon-bounce", "hi:gift!@stroke-rounded", "icon-3x icon-bounce", "--icon-bounce-height: -1em; --icon-bounce-rebound: -.5em;"),
            ("icon-beat-fade", "hi:favourite!@stroke-rounded", "icon-3x icon-beat-fade", "--icon-beat-fade-opacity: .15; --icon-beat-fade-scale: 1.4;"),
            ("icon-flip", "hi:credit-card!@stroke-rounded", "icon-3x icon-flip", "--icon-flip-axis-x: 1; --icon-flip-axis-y: 0; --icon-flip-axis-z: 0; --icon-flip-angle: 180deg;"),
            ("icon-shake", "hi:megaphone-01!@stroke-rounded", "icon-3x icon-shake", "--icon-shake-angle: -30deg;"),
        ]),
    };
}

@* Keep demo layout separate from icon sizing: only the icon utilities control SVG dimensions. *@
<style>
    #hi-utility-demo .hi-demo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
        gap: 8px;
    }
    #hi-utility-demo figure { margin: 0; padding: 8px; border: 1px solid var(--gray-300); border-radius: 6px; }
    #hi-utility-demo .hi-demo-stage { display: flex; align-items: center; justify-content: center; min-height: 88px; font-size: 16px; padding: 8px; }
    #hi-utility-demo .hi-demo-sizes { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
    #hi-utility-demo .hi-demo-sizes .hi-demo-stage { min-height: 190px; }
    #hi-utility-demo .hi-demo-motion-space .hi-demo-stage { min-height: 144px; }
    #hi-utility-demo .hi-demo-layout { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
    #hi-utility-demo code { overflow-wrap: anywhere; white-space: normal; }
    #hi-utility-demo figcaption { display: grid; gap: 4px; font-size: 12px; }
    #hi-utility-demo details { margin-top: 24px; }
    #hi-utility-demo summary { cursor: pointer; font-weight: 600; font-size: 16px; margin-bottom: 12px; }
    .section-header:has(#hi-demo-bounds:checked) + #icon-cheatsheet .hi-demo-content .icon { outline: 1px dashed var(--gray-500); background-color: rgba(127, 127, 127, .08); }
    .section-header:has(#hi-demo-pause:checked) + #icon-cheatsheet .hi-demo-content :is(.icon, .icon-stack) { animation-play-state: paused !important; }
    #hi-utility-demo .hi-demo-line { padding: 8px; border-bottom: 1px solid var(--gray-300); }
    #hi-utility-demo .hi-demo-dark { background: #393f46; border-radius: 4px; }
    #hi-utility-demo .hi-demo-motion-note { display: none; }
    @@media (prefers-reduced-motion: reduce) {
        #hi-utility-demo .hi-demo-motion-note { display: block; }
    }
</style>

<section id="hi-utility-demo" class="mb-5 border rounded p-3" aria-labelledby="hi-utility-title">
    <h2 id="hi-utility-title" class="h4">HugeIcons / CSS utilities</h2>
    <p class="text-muted">Live SVG examples using the stroke-rounded variant. Effects use icon-3x (48px); size and text-layout examples retain their own scale. Open or close each group to compare effects.</p>
    <p class="hi-demo-motion-note text-muted">Your reduced-motion preference is active. Icon animations are disabled.</p>
    <div class="hi-demo-content">
        <details open>
            <summary>Web components</summary>
            <p class="text-muted">Rendered in the browser with sm-icon. The cart pair shares its resources; stroke-scale forces inline SVG. Use the controls above to pause animations or show bounds.</p>
            <div class="hi-demo-grid">
                <figure>
                    <div class="hi-demo-stage gap-2">
                        <sm-icon name="cart" lib="hi" variant="sr" size="3x" aria-label="Cart"></sm-icon>
                        <sm-icon name="cart" lib="hi" variant="sr" size="3x" aria-label="Cart duplicate"></sm-icon>
                    </div>
                    <figcaption><strong>Kit / repeated icon</strong><code>&lt;sm-icon name="cart" size="3x"&gt;&lt;/sm-icon&gt;</code></figcaption>
                </figure>
                <figure>
                    <div class="hi-demo-stage">
                        <sm-icon name="cart" lib="hi" variant="sr" size="3x" stroke-scale="1.1" aria-label="Cart with thicker strokes"></sm-icon>
                    </div>
                    <figcaption><strong>Inline SVG</strong><code>name="cart" stroke-scale="1.1"</code></figcaption>
                </figure>
                <figure>
                    <div class="hi-demo-stage">
                        <sm-icon name="refresh" lib="hi" variant="sr" size="3x" animation="spin" animation-duration="3s" aria-label="Refresh"></sm-icon>
                    </div>
                    <figcaption><strong>Animation</strong><code>animation="spin" animation-duration="3s"</code></figcaption>
                </figure>
                <figure>
                    <div class="hi-demo-stage">
                        <sm-icon-stack size="2x" aria-label="Confirmed">
                            <sm-icon name="circle" lib="hi" variant="sr" class="icon-stack-2x"></sm-icon>
                            <sm-icon name="check" lib="hi" variant="sr" class="icon-stack-1x"></sm-icon>
                        </sm-icon-stack>
                    </div>
                    <figcaption><strong>Stack</strong><code>&lt;sm-icon-stack size="2x"&gt;</code><span>Independent circle and check layers.</span></figcaption>
                </figure>
            </div>
        </details>
        @foreach (var group in utilityGroups)
        {
            <details open>
                <summary>@group.Title</summary>
                <p class="text-muted">@group.Hint</p>
                <div class="hi-demo-grid @(group.Large ? "hi-demo-sizes" : null)">
                    @foreach (var sample in group.Samples)
                    {
                        <figure class="@(sample.Style.Contains("--icon-bounce-height") ? "hi-demo-motion-space" : null)">
                            <div class="hi-demo-stage">
                                <icon name="@sample.Name" class="@sample.Css" style="@sample.Style" />
                            </div>
                            <figcaption>
                                <strong>@sample.Label</strong>
                                @if (sample.Css.Length > 0 && sample.Label != sample.Css)
                                {
                                    <code>@sample.Css</code>
                                }
                                @if (sample.Style.Length > 0)
                                {
                                    <code>@sample.Style</code>
                                }
                            </figcaption>
                        </figure>
                    }
                </div>
            </details>
        }
        <details open>
            <summary>Text alignment and minimum size</summary>
            <p class="text-muted">At 14px and 15px text, the base icon stays 16px; smaller utilities scale that base down.</p>
            @foreach (var textSize in new[] { 14, 15, 20 })
            {
                <div class="hi-demo-line" style="font-size: @(textSize)px;">
                    <span class="mr-3">@(textSize)px text</span>
                    @foreach (var size in new[] { "icon-2xs", "icon-xs", "icon-sm", "icon-1x", "icon-lg", "icon-xl", "icon-2xl" })
                    {
                        <span class="d-inline-block mr-3 mb-2"><icon name="hi:gift!@@stroke-rounded" class="@size" /> Ag <code>@size</code></span>
                    }
                </div>
            }
            <div class="hi-demo-line" style="font-size: 12px;">
                <icon name="hi:gift!@@stroke-rounded" /> Default minimum (16px)
                <icon name="hi:gift!@@stroke-rounded" style="--icon-min-size: 0px;" /> <code>--icon-min-size: 0px</code> (12px)
            </div>
            <div class="hi-demo-line">
                Text <icon name="hi:gift!@@stroke-rounded" style="--icon-align: baseline;" /> <code>--icon-align: baseline</code>
                Text <icon name="hi:gift!@@stroke-rounded" style="--icon-align: middle;" /> <code>--icon-align: middle</code>
            </div>
        </details>
        <details open>
            <summary>Fixed width, lists and stacks</summary>
            <div class="hi-demo-grid hi-demo-layout">
                <figure>
                    <div class="hi-demo-stage">
                        <div>
                            <div><icon name="hi:search-01!@@stroke-rounded" class="icon-fw" /> Search</div>
                            <div><icon name="hi:delivery-truck-01!@@stroke-rounded" class="icon-fw" /> Delivery</div>
                            <div><icon name="hi:favourite!@@stroke-rounded" class="icon-fw" /> Favorites</div>
                        </div>
                    </div>
                    <figcaption><code>icon-fw</code><span>1.25em width; enable bounds to inspect.</span></figcaption>
                </figure>
                @foreach (var direction in new[] { "ltr", "rtl" })
                {
                    <figure>
                        <div dir="@direction" class="p-3">
                            <ul class="icon-ul" style="--icon-li-margin: 2em; --icon-li-width: 1.5em;">
                                <li><span class="icon-li"><icon name="hi:tick-02!@@stroke-rounded" /></span>First list item</li>
                                <li><span class="icon-li"><icon name="hi:gift!@@stroke-rounded" /></span>A longer list item that wraps onto another line to check marker alignment.</li>
                            </ul>
                        </div>
                        <figcaption><code>icon-ul / icon-li</code><span>@direction</span><code>--icon-li-margin: 2em; --icon-li-width: 1.5em</code></figcaption>
                    </figure>
                }
                <figure>
                    <div class="hi-demo-stage">
                        <icon-stack size="2x">
                            <icon name="hi:circle!@@stroke-rounded" class="icon-stack-2x" />
                            <icon name="hi:tick-02!@@stroke-rounded" class="icon-stack-1x" />
                        </icon-stack>
                    </div>
                    <figcaption><code>icon-stack icon-2x</code><code>icon-stack-2x + icon-stack-1x</code></figcaption>
                </figure>
                <figure>
                    <div class="hi-demo-stage">
                        <icon-stack size="2x" style="--icon-stack-width: 3em; --icon-stack-height: 2.5em; --icon-stack-align: middle;">
                            <icon name="hi:gift!@@stroke-rounded" class="icon-stack-2x" />
                            <icon name="hi:cancel-01!@@stroke-rounded" class="icon-stack-1x icon-bounce" style="--icon-color: var(--danger); --icon-stack-z-index: 1; --icon-shift-x: .8em; --icon-shift-y: .6em;" />
                        </icon-stack>
                    </div>
                    <figcaption><span>Custom stack + animated badge</span><code>--icon-stack-width: 3em; --icon-stack-height: 2.5em; --icon-stack-align: middle</code><code>--icon-stack-z-index: 1; --icon-shift-x: .8em; --icon-shift-y: .6em</code></figcaption>
                </figure>
                <figure>
                    <div class="hi-demo-stage hi-demo-dark">
                        <icon name="hi:favourite!@@stroke-rounded" class="icon-3x icon-inverse" />
                        <icon name="hi:gift!@@stroke-rounded" class="icon-3x icon-inverse ml-3" style="--icon-inverse: #ffd166;" />
                    </div>
                    <figcaption><code>icon-inverse</code><code>--icon-inverse: #ffd166</code></figcaption>
                </figure>
                <figure>
                    <div class="hi-demo-stage">
                        <span class="icon icon-3x icon-rotate-90"><icon name="hi:delivery-truck-01!@@stroke-rounded" class="icon-1x" style="--icon-min-size: 0px;" /></span>
                    </div>
                    <figcaption><span>Host sizing + rotation</span><code>Host: icon icon-3x icon-rotate-90</code><span>Child SVG fills its host.</span></figcaption>
                </figure>
            </div>
        </details>
        <details open>
            <summary>Button sizes</summary>
            <div class="d-flex flex-wrap align-items-center gap-3 py-3">
                <button type="button" class="btn btn-secondary btn-sm"><icon name="hi:gift!@@stroke-rounded" class="mr-1" /> Small</button>
                <button type="button" class="btn btn-secondary"><icon name="hi:gift!@@stroke-rounded" class="mr-1" /> Default</button>
                <button type="button" class="btn btn-secondary btn-lg"><icon name="hi:gift!@@stroke-rounded" class="mr-1" /> Large</button>
                <button type="button" class="btn btn-primary btn-lg"><icon name="hi:gift!@@stroke-rounded" class="mr-1" /> Large primary</button>
            </div>
            <p class="text-muted"><code>.btn-lg .icon-hi</code> supplies a 20px minimum. Icons inherit the button color.</p>
        </details>
    </div>
</section>
