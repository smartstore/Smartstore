            ("Explicit size", "hi:settings-01!@stroke-rounded", "", "--icon-size: 28px;"),
            ("Calculated size", "hi:settings-01!@stroke-rounded", "", "--icon-size: calc(1em + 8px);"),
            ("Minimum size", "hi:settings-01!@stroke-rounded", "", "--icon-min-size: 24px;"),
            ("Size factor", "hi:settings-01!@stroke-rounded", "", "--icon-size-factor: 1.5;"),
            ("Color", "hi:settings-01!@stroke-rounded", "icon-3x", "--icon-color: var(--primary);"),
            ("Stroke overrides", "hi:settings-01!@stroke-rounded", "icon-3x", "--icon-stroke: var(--success); --icon-stroke-width: 2;"),
            ("Rotation variable", "hi:settings-01!@stroke-rounded", "icon-3x", "--icon-rotate: 25deg;"),
            ("Scale", "hi:settings-01!@stroke-rounded", "", "--icon-scale: 1.4;"),
            ("Flip variables", "hi:delivery-truck-01!@stroke-rounded", "icon-3x", "--icon-flip-x: -1; --icon-flip-y: -1;"),
            ("Translation", "hi:settings-01!@stroke-rounded", "icon-3x", "--icon-shift-x: 8px; --icon-shift-y: -8px;"),
