            ("animate-spin-pulse-reverse", "hi:settings-01!@stroke-rounded", "icon-3x animate-spin-pulse-reverse", ""),
            ("animate-fade", "hi:settings-01!@stroke-rounded", "icon-3x animate-fade", ""),
            ("animate-beat", "hi:settings-01!@stroke-rounded", "icon-3x animate-beat", ""),
