@* Compare local HI SVGs with the matching HI webfont; BI keeps the existing admin sprite. *@

<link rel="stylesheet" href="https://use.hugeicons.com/font/icons.css" />

<style>
    #icon-cheatsheet .dropdown-item {
        --dropdown-link-color: #393f46;
        --dropdown-link-hover-color: #393f46;
    }

    #icon-cheatsheet .nav-link {
        --nav-link-color: #393f46;
        --nav-link-hover-color: #393f46;
    }

    /* The shared vertical tabs assign a fixed icon color; use the link's variable here. */
    #icon-cheatsheet .nav-link:not(.active) > :is(i, svg) {
        color: var(--nav-link-color);
    }
    .hgi-stroke {
        font-weight: 400;
    }

    #icon-cheatsheet .comparison-heading {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    #icon-cheatsheet .comparison-mute-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font-size: 14px;
        line-height: 1;
        cursor: pointer;
    }

    #icon-cheatsheet .comparison-mute-toggle:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
    }

    #icon-cheatsheet .comparison-muted {
        opacity: 0.15;
    }

    #icon-cheatsheet .admin-navbar-preview {
        display: flex;
        align-items: center;
        min-width: 1030px;
        height: 72px;
        padding: 0 32px;
        background: #24539b;
        color: #c8d9f2;
    }

    #icon-cheatsheet .admin-navbar-logo {
        flex: 0 0 160px;
        width: 160px;
        height: 28px;
        margin-right: 16px;
    }

    #icon-cheatsheet .admin-navbar-links,
    #icon-cheatsheet .admin-navbar-tools {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    #icon-cheatsheet .admin-navbar-tools {
        margin-left: auto;
        padding-left: 24px;
    }

    #icon-cheatsheet .admin-navbar-item,
    #icon-cheatsheet .admin-navbar-tool {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 72px;
        padding: 0 8px;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        white-space: nowrap;
    }

    #icon-cheatsheet .admin-navbar-item {
        flex-direction: column;
        gap: 4px;
        font-size: 12px;
        line-height: 18px;
    }

    #icon-cheatsheet .admin-navbar-tool {
        gap: 8px;
        padding-inline: 10px;
    }

    #icon-cheatsheet .admin-navbar-tools > li:last-child {
        margin-left: 16px;
    }

    #icon-cheatsheet .admin-navbar-preview button:hover {
        background: rgba(255, 255, 255, .15);
        color: #fff;
    }

    #icon-cheatsheet .admin-navbar-preview :is(i, svg.icon) {
        display: block;
        width: 24px;
        height: 24px;
        line-height: 24px;
        font-size: 20px;
        text-align: center;
    }

    #icon-cheatsheet .admin-navbar-preview :is(.icon, .hgi-stroke) {
        font-size: 24px;
    }

    #icon-cheatsheet .comparison-scroll {
        overflow-x: auto;
        padding: 2px 2px 12px;
    }

    #icon-cheatsheet .comparison-dropdowns {
        overflow: visible;
    }

    #icon-cheatsheet .comparison-grid {
        display: grid;
        grid-template-columns: repeat(3, max-content);
        gap: 24px;
        justify-content: start;
    }

    #icon-cheatsheet .comparison-menu {
        display: block;
        position: static;
        float: none;
        width: max-content;
        min-width: 0;
        margin: 0;
        transform: none;
    }

    #icon-cheatsheet .comparison-menu .dropdown-item {
        cursor: default;
        white-space: nowrap;
        min-height: 36px;
    }

    #icon-cheatsheet .comparison-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 16px;
        width: 16px;
        height: 16px;
        min-width: 16px;
        min-height: 16px;
        font-size: 16px;
        line-height: 1;
        vertical-align: middle;
    }

    #icon-cheatsheet .comparison-icon > i,
    #icon-cheatsheet .comparison-icon > svg {
        display: block;
        width: 16px;
        height: 16px;
        min-width: 16px;
        min-height: 16px;
        font-size: 16px;
        line-height: 1;
        margin: 0;
    }


    /* Summernote's SVG fill rule targets filled toolbar icons; preserve HI outline geometry. */
    #icon-cheatsheet svg.icon[fill="none"] {
        fill: none;
    }

    #icon-cheatsheet .account-comparison .comparison-icon > .fal {
        font-size: 14px;
    }

    #icon-cheatsheet .button-comparison .btn > :is(i, svg) {
        font-size: 16px;
    }

    #icon-cheatsheet .button-comparison .btn > .comparison-icon-fa {
        font-size: 14px;
    }

    #icon-cheatsheet :is([data-comparison-library="HI"], [data-comparison-library="HI-Font"]) :is(.btn-secondary, .btn-light),
    #icon-cheatsheet :is([data-comparison-library="HI"], [data-comparison-library="HI-Font"]):is(.btn-secondary, .btn-light) {
        --btn-icon-color: inherit;
    }

    #icon-cheatsheet .toolbar-comparison .options {
        display: flex;
        align-items: center;
        gap: 8px;
        width: max-content;
    }

    #icon-cheatsheet .product-tabs-comparison .nav-aside {
        width: 250px;
    }

    #icon-cheatsheet .product-tabs-comparison .nav-icon {
        width: 16px;
        min-width: 16px;
        height: 16px;
        font-size: 16px;
        line-height: 16px;
    }

    #icon-cheatsheet .toolbar-comparison .btn > :is(i, svg.icon) {
        font-size: 16px;
    }

    #icon-cheatsheet .toolbar-comparison [data-library="FA"] .btn > i {
        font-size: 14px;
    }

    #icon-cheatsheet .cart-comparison .btn {
        --icon-min-size: 20px;
        --btn-bg: #3f51b5;
        --btn-disabled-bg: #3f51b5;
        --btn-disabled-border-color: #59616726;
        --btn-hover-bg: #36459a;
        --btn-hover-shadow: 0 1px 0 #22262a0a, inset 0 1px 0 #ffffff40;
        --btn-focus-shadow-rgb: 203, 205, 207;
        --btn-active-bg: #324191;
        --btn-active-shadow: inset 0 3px 5px #00000020;
        width: 350px;
    }

    #icon-cheatsheet .cart-comparison .btn > .hgi-stroke {
        font-size: max(1em, var(--icon-min-size, 16px));
    }
    #icon-cheatsheet .comparison-table {
        width: auto;
        table-layout: auto;
    }

    #icon-cheatsheet .mapped-icons-details > summary {
        cursor: pointer;
    }

    #icon-cheatsheet .comparison-table .comparison-icon > .comparison-icon-fa {
        font-size: 14px;
    }

    #icon-cheatsheet .product-actions-comparison {
        grid-template-columns: repeat(2, max-content);
    }

    #icon-cheatsheet .product-actions-panel {
        width: 520px;
        padding: 15px;
        border-radius: 0 0 16px 16px;
        background: var(--gray-100);
    }

    #icon-cheatsheet .product-actions-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid rgba(0, 0, 0, .15);
        padding-top: 15px;
    }

    #icon-cheatsheet .product-action {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 6px 0 4px;
        border: 0;
        border-inline-end: 1px solid rgba(0, 0, 0, .15);
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: 14px;
        line-height: 20px;
    }

    #icon-cheatsheet .product-action:last-child {
        border-inline-end: 0;
    }

    #icon-cheatsheet .product-action > :is(i, svg.icon) {
        display: block;
        font-size: 20px;
        line-height: 20px;
        height: 20px;
    }

    #icon-cheatsheet .product-action > :is(.icon, .hgi-stroke) {
        font-size: 24px;
        line-height: 24px;
        height: 24px;
    }

    #icon-cheatsheet .button-comparison {
        display: grid;
        grid-template-columns: repeat(4, max-content);
        gap: 12px 24px;
        width: max-content;
    }

    #icon-cheatsheet .comparison-table th {
        white-space: nowrap;
    }

    #icon-cheatsheet .inventory-icon-row {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    #icon-cheatsheet .migration-hi-name {
        max-height: 24px;
        width: 24ch;
        margin-inline: auto;
        font-size: 11px;
        text-align: center;
    }

    #icon-cheatsheet .migration-source-icons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px 16px;
        max-width: 440px;
    }

    #icon-cheatsheet .comparison-table td {
        vertical-align: middle;
        padding-top: 16px;
        padding-bottom: 16px;
    }

    #icon-cheatsheet .icon-name {
        display: block;
        margin-top: 8px;
        font-size: 11px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--gray-600);
    }
</style>

<div id="icon-cheatsheet">
    <div class="section-header">
        <div class="title">Icon cheatsheet <small class="text-muted">16 px</small></div>
    </div>

    <div class="px-3 pb-5">
        <section class="mb-5" aria-labelledby="icon-browser-title">
            <h2 id="icon-browser-title" class="h4">IconBrowser</h2>
            <div style="max-width: 600px">
                @await Html.PartialAsync("IconBrowser")
            </div>
        </section>

        @await Html.PartialAsync("_IconCheatsheetUtilities")

        <section class="mb-5" aria-labelledby="iconkit-preview-title">
            <h2 id="iconkit-preview-title" class="h4">IconKit / Local SVG</h2>
            <div class="d-flex align-items-center gap-3">
                <icon name="hi:search-01" aria-label="Search" />
                <icon name="shopping-cart-02" lib="hugeicons" variant="stroke-rounded" class="icon-2x" aria-label="Cart" />
                <button type="button" class="btn btn-primary">
                    <icon name="hi:floppy-disk" class="icon-fw mr-1" /> Save
                </button>
            </div>
        </section>

        <section class="mb-5 d-none" aria-labelledby="navbar-comparison-title">
            <h2 id="navbar-comparison-title" class="h4">Backend / Main menu</h2>
            @foreach (string library in new[] { "HI", "HI-Font" })
            {
                <h3 class="h6 text-muted comparison-heading mb-2">@LibraryLabel(library) @{ await RenderMuteButton(library); }</h3>
                <div class="comparison-scroll mb-2" data-comparison-library="@library">
                    <nav class="admin-navbar-preview" aria-label="@($"{library} admin menu preview")">
                        <img class="admin-navbar-logo" src="~/images/smartstore.svg" alt="Smartstore" width="160" height="28" />
                        <ul class="admin-navbar-links">
                            @foreach (var item in navbarItems)
                            {
                                <li>
                                    <button type="button" class="admin-navbar-item">
                                        <icon sm-if='@(library == "HI")' name="@item.Huge" lib="hi" aria-hidden="true" />
                                        <i sm-if='@(library != "HI")' class="@("hgi-stroke hgi-" + HugeFontName(item.Huge))" aria-hidden="true"></i>
                                        <span>@item.Label</span>
                                    </button>
                                </li>
                            }
                        </ul>
                        <ul class="admin-navbar-tools">
                            @foreach (var item in navbarTools)
                            {
                                <li>
                                    <button type="button" class="admin-navbar-tool" aria-label="@item.Label" title="@item.Label">
                                        <icon sm-if='@(library == "HI")' name="@item.Huge" lib="hi" aria-hidden="true" />
                                        <i sm-if='@(library != "HI")' class="@("hgi-stroke hgi-" + HugeFontName(item.Huge))" aria-hidden="true"></i>
                                        @if (item.Text != null)
                                        {
                                            <span>@item.Text</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </section>

        <section class="mb-5 account-comparison" aria-labelledby="frontend-comparison-title">
            <h2 id="frontend-comparison-title" class="h4">Frontend / Account menu</h2>
            <div class="comparison-scroll comparison-dropdowns">
                <div class="comparison-grid">
                    @foreach (string library in frontendLibraries)
                    {
                        <div>
                            <h3 class="h6 text-muted comparison-heading mb-2">@(library == "FA" ? "FontAwesome / Current" : LibraryLabel(library)) @{ await RenderMuteButton(library); }</h3>
                            <div class="dropdown-menu dropdown-menu-right show comparison-menu" data-comparison-library="@library">
                                @foreach (var item in frontendItems)
                                {
                                    if (item.FontAwesome == "fa-right-from-bracket")
                                    {
                                        <div class="dropdown-divider" role="separator"></div>
                                    }
                                    <span class="dropdown-item">
                                        <span class="comparison-icon" aria-hidden="true">
                                            @if (library == "FA")
                                            {
                                                <i class="fal @item.FontAwesome fa-fw"></i>
                                            }
                                            else if (library == "HI")
                                            {
                                                <icon name="@item.Huge" lib="hi" />
                                            }
                                            else
                                            {
                                                <i class="hgi-stroke hgi-@(HugeFontName(item.Huge))"></i>
                                            }
                                        </span>
                                        <span>@item.Label</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="mb-5" aria-labelledby="cart-comparison-title">
            <h2 id="cart-comparison-title" class="h4">Frontend / Add to cart</h2>
            <div class="comparison-scroll">
                <div class="comparison-grid cart-comparison">
                    @foreach (string library in frontendLibraries)
                    {
                        <div>
                            <h3 class="h6 text-muted comparison-heading mb-2">@(library == "FA" ? "FontAwesome / Current" : LibraryLabel(library)) @{ await RenderMuteButton(library); }</h3>
                            <button type="button" class="btn btn-primary btn-lg btn-block btn-add-to-cart" data-comparison-library="@library" aria-label="@($"In den Warenkorb / {library} preview")">
                                @if (library == "FA")
                                {
                                    <i class="fa fa-cart-arrow-down" aria-hidden="true"></i>
                                }
                                else if (library == "HI")
                                {
                                    <icon name="shopping-cart-add-01" lib="hi" aria-hidden="true" />
                                }
                                else
                                {
                                    <i class="hgi-stroke hgi-shopping-cart-add-01" aria-hidden="true"></i>
                                }
                                <span>In den Warenkorb</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="mb-5" aria-labelledby="product-actions-comparison-title">
            <h2 id="product-actions-comparison-title" class="h4">Frontend / Product actions</h2>
            <div class="comparison-scroll">
                <div class="comparison-grid product-actions-comparison">
                    @foreach (string library in productActionLibraries)
                    {
                        <div>
                            <h3 class="h6 text-muted comparison-heading mb-2">@LibraryLabel(library) @{ await RenderMuteButton(library); }</h3>
                            <div class="product-actions-panel" data-comparison-library="@library">
                                <div class="product-actions-bar">
                                    @foreach (var action in productActions)
                                    {
                                        <button type="button" class="product-action" aria-label="@($"{action.Label} / {library} preview")">
                                            @if (library == "HI")
                                            {
                                                <icon name="@action.Huge" lib="hi" aria-hidden="true" />
                                            }
                                            else
                                            {
                                                <i class="hgi-stroke hgi-@(HugeFontName(action.Huge))" aria-hidden="true"></i>
                                            }
                                            <span>@action.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <p class="text-muted">
            HugeIcons Stroke Rounded as local SVGs and webfonts alongside the current Bootstrap Icons.
            BI, HI SVG and HI webfont are shown at 16 px in the same color, with each library's native stroke weight.
            Menus are static previews of the admin sitemap; Plugins and CMS use the supplied menu snapshots.
        </p>
        <p id="icon-font-status" class="small text-muted" role="status" aria-live="polite">Loading HugeIcons comparison font...</p>

        @foreach (var menu in menus)
        {
            var path = string.Join(" / ", menu.AncestorsAndSelf("siteMapNode")
                .TakeWhile(x => x != Model).Reverse().Select(GetLabel));
            <section class="mb-5" aria-label="@path">
                <h2 class="h5 mb-3">@path</h2>
                <div class="comparison-scroll comparison-dropdowns">
                    <div class="comparison-grid">
                        @foreach (string library in libraries)
                        {
                            <div>
                                <h3 class="h6 text-muted comparison-heading mb-2">@LibraryLabel(library) @{ await RenderMuteButton(library); }</h3>
                                <ul class="dropdown-menu comparison-menu" data-comparison-library="@library">
                                    @{
                                        bool isFirst = true;
                                        bool hasIcons = menu.Elements("siteMapNode").Any(x => GetBootstrapIcon(x) != null);
                                    }
                                    @foreach (var item in menu.Elements("siteMapNode"))
                                    {
                                        if ((bool?)item.Attribute("isGroupHeader") == true)
                                        {
                                            if (!isFirst)
                                            {
                                                <li class="dropdown-divider" role="separator"></li>
                                            }
                                            if ((string)item.Attribute("title") != "[SKIP]")
                                            {
                                                <li class="dropdown-header h6">@GetLabel(item)</li>
                                            }
                                        }
                                        else
                                        {
                                            <li>
                                                <span class="dropdown-item @((string)item.Attribute("id") == "modules-manage" ? "font-weight-bold" : null)">
                                                    @if (hasIcons)
                                                    {
                                                        await RenderIcon(GetBootstrapIcon(item), library, (string)item.Attribute("iconClass"),
                                                            (string)item.Attribute("id") ?? (string)item.Attribute("title"));
                                                    }
                                                    <span>@GetLabel(item)</span>
                                                    @if (item.Elements("siteMapNode").Any())
                                                    {
                                                        <span class="ml-auto">
                                                            @{ await RenderIcon("chevron-right", library); }
                                                        </span>
                                                    }
                                                </span>
                                            </li>
                                        }
                                        isFirst = false;
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="mb-5 product-tabs-comparison" aria-labelledby="product-tabs-comparison-title">
            <h2 id="product-tabs-comparison-title" class="h4">Product-Edit Tab menu comparison</h2>
            <div class="comparison-scroll">
                <div class="comparison-grid">
                    @foreach (string library in libraries)
                    {
                        <div>
                            <h3 class="h6 text-muted comparison-heading mb-2">@(library == "BI" ? "Original (BI)" : LibraryLabel(library)) @{ await RenderMuteButton(library); }</h3>
                            <aside class="nav-aside" data-comparison-library="@library" aria-label="@($"{library} product tabs preview")">
                                <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-dense nav-stacked flex-column nav-left">
                                    @for (int index = 0; index < productTabs.Length; index++)
                                    {
                                        var tab = productTabs[index];
                                        <li class="nav-item">
                                            <span class="nav-link @(index == 0 ? "active" : null)" aria-current="@(index == 0 ? "page" : null)">
                                                @if (library == "BI")
                                                {
                                                    if (tab.Bootstrap != null)
                                                    {
                                                        <bootstrap-icon name="@tab.Bootstrap" class="bi-fw nav-icon" aria-hidden="true" />
                                                    }
                                                    else
                                                    {
                                                        @* Preserve the original FA exception for the warranty tab. *@
                                                        <i class="far fa-section bi-fw nav-icon" aria-hidden="true"></i>
                                                    }
                                                }
                                                else
                                                {
                                                    <icon sm-if='@(library == "HI")' name="@tab.Huge" lib="hi" class="nav-icon" aria-hidden="true" />
                                                    <i sm-if='@(library != "HI")' class="@("hgi-stroke hgi-" + HugeFontName(tab.Huge)) nav-icon" aria-hidden="true"></i>
                                                }
                                                <span class="tab-caption">@tab.Label</span>
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </aside>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="mb-5 toolbar-comparison" aria-labelledby="product-edit-toolbar-comparison-title">
            <h2 id="product-edit-toolbar-comparison-title" class="h4">ProductEdit Toolbar comparison</h2>
            @foreach (string library in frontendLibraries)
            {
                <div class="mb-4" data-library="@library">
                    <h3 class="h6 text-muted comparison-heading mb-2">@(library == "FA" ? "Original / FA" : LibraryLabel(library)) @{ await RenderMuteButton(library); }</h3>
                    <div class="options" role="group" data-comparison-library="@library" aria-label="@($"{library} product edit toolbar preview")">
                        <button type="button" class="btn btn-outline-secondary">
                            <icon sm-if='@(library == "HI")' name="eye" lib="hi" aria-hidden="true" />
                            <i sm-if='@(library != "HI")' class="@(library == "FA" ? "far fa-eye" : "hgi-stroke hgi-eye")" aria-hidden="true"></i>
                            <span>Vorschau</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary">
                            <icon sm-if='@(library == "HI")' name="copy-02" lib="hi" aria-hidden="true" />
                            <i sm-if='@(library != "HI")' class="@(library == "FA" ? "far fa-copy" : "hgi-stroke hgi-copy-02")" aria-hidden="true"></i>
                            <span>Produkt kopieren</span>
                        </button>
                        <span class="vr" aria-hidden="true"></span>
                        <button type="button" class="btn btn-warning">
                            <icon sm-if='@(library == "HI")' name="tick-02" lib="hi" aria-hidden="true" />
                            <i sm-if='@(library != "HI")' class="@(library == "FA" ? "fa fa-check" : "hgi-stroke hgi-tick-02")" aria-hidden="true"></i>
                            <span>Speichern</span>
                        </button>
                        <button type="button" class="btn btn-secondary">
                            Speichern und fortsetzen
                        </button>
                        <button type="button" class="btn btn-danger">
                            <icon sm-if='@(library == "HI")' name="delete-02" lib="hi" aria-hidden="true" />
                            <i sm-if='@(library != "HI")' class="@(library == "FA" ? "far fa-trash-can" : "hgi-stroke hgi-delete-02")" aria-hidden="true"></i>
                            <span>Löschen</span>
                        </button>
                    </div>
                </div>
            }
        </section>

        <section class="mb-5 toolbar-comparison" aria-labelledby="toolbar-comparison-title">
            <h2 id="toolbar-comparison-title" class="h4">PageBuilder Toolbar comparison</h2>
            @foreach (string library in frontendLibraries)
            {
                <div class="mb-4" data-library="@library">
                    <h3 class="h6 text-muted comparison-heading mb-2">@(library == "FA" ? "FA / Original" : LibraryLabel(library)) @{ await RenderMuteButton(library); }</h3>
                    <div class="options" role="group" data-comparison-library="@library" aria-label="@($"{library} toolbar preview")">
                        @foreach (var group in toolbarButtons.GroupBy(x => x.Group))
                        {
                            <div class="btn-group" role="group">
                                @foreach (var button in group)
                                {
                                    <button type="button" class="btn btn-secondary @button.Css" title="@button.Title" aria-label="@button.Title" disabled="@button.Disabled">
                                        <icon sm-if='@(library == "HI")' name="@button.Huge" lib="hi" aria-hidden="true" />
                                        <i sm-if='@(library != "HI")' class="@(library == "FA" ? button.FontAwesome : "hgi-stroke hgi-" + HugeFontName(button.Huge))" aria-hidden="true"></i>
                                        @if (button.Label != null)
                                        {
                                            <span>@button.Label</span>
                                        }
                                    </button>
                                }
                                @if (group.Key == 0)
                                {
                                    <button type="button" id="toolbar-save-split-@library" class="btn btn-secondary dropdown-toggle dropdown-toggle-split"
                                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Weitere Speicheroptionen"></button>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="toolbar-save-split-@library">
                                        <button type="button" class="dropdown-item">Als Vorlage speichern...</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="mb-5" aria-labelledby="html-editor-toolbar-comparison-title">
            <h2 id="html-editor-toolbar-comparison-title" class="h4">HtmlEditor Toolbar comparison</h2>
            @foreach (string library in new[] { "Original", "HI", "HI-Font" })
            {
                <div class="mb-4">
                    <h3 class="h6 text-muted comparison-heading mb-2">@(library == "Original" ? "Original / Embedded SVG" : LibraryLabel(library)) @{ await RenderMuteButton(library); }</h3>
                    @await Html.PartialAsync("_IconCheatsheetHtmlEditorToolbar", library)
                </div>
            }
        </section>

        <section class="mb-5" aria-labelledby="button-comparison-title">
            <h2 id="button-comparison-title" class="h4">Button comparison</h2>
            <p class="text-muted">Common admin actions: FontAwesome at 14 px; BI, HI SVG and HI webfont at 16 px. Preview buttons have no actions.</p>
            <div class="comparison-scroll">
                <div class="button-comparison">
                    @foreach (string library in buttonLibraries)
                    {
                        <h3 class="h6 text-muted comparison-heading mb-1">@(library == "FA" ? "FontAwesome" : library) @{ await RenderMuteButton(library); }</h3>
                    }
                    @foreach (var button in buttons)
                    {
                        @foreach (string library in buttonLibraries)
                        {
                            <div data-comparison-library="@library">
                                <button type="button" class="btn btn-@button.Style" aria-label="@($"{button.Label} / {library} preview")">
                                    @if (library == "FA")
                                    {
                                        <i class="@button.FontAwesome comparison-icon-fa" aria-hidden="true" title="@button.FontAwesome"></i>
                                    }
                                    else if (library == "HI")
                                    {
                                        <icon name="@icons[button.Bootstrap].Huge" lib="hi" aria-hidden="true" />
                                    }
                                    else if (library == "HI-Font")
                                    {
                                        <i class="hgi-stroke hgi-@(HugeFontName(icons[button.Bootstrap].Huge))" aria-hidden="true"></i>
                                    }
                                    else
                                    {
                                        string spriteName = GetSpriteName(button.Bootstrap);
                                        <bootstrap-icon name="@spriteName" flip-h="@(spriteName != button.Bootstrap)" aria-hidden="true" />
                                    }
                                    <span>@button.Label</span>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </section>

        @await Html.PartialAsync("_IconCheatsheetInventory")
    </div>
</div>

@{
    async Task RenderMuteButton(string library)
    {
        <button type="button" class="comparison-mute-toggle" data-mute-library="@library"
                aria-pressed="false" aria-label="@($"Mute {library}")" title="@($"Mute {library}")">
            <i class="far fa-eye" aria-hidden="true"></i>
        </button>
    }

    // The SVG package and webfont use different names for these equivalent glyphs.
    string HugeFontName(string name) => name switch
    {
        "sorting-1-9" => "sorting-one-9",
        _ => name
    };

    string LibraryLabel(string library) => library switch
    {
        "HI" => "HI / SVG",
        "HI-Font" => "HI / Webfont",
        _ => "BI / Current admin icons"
    };

    string GetLabel(XElement node)
    {
        string resourceKey = (string)node.Attribute("resKey");
        return resourceKey.HasValue() ? T(resourceKey).Value : (string)node.Attribute("title");
    }

    string GetBootstrapIcon(XElement node)
    {
        string icon = ((string)node.Attribute("icon"))?.Trim();
        return icon?.StartsWith("bi:", StringComparison.Ordinal) == true ? icon[3..] : null;
    }

    // The admin sprite contains only the right-facing variants of these two icons.
    string GetSpriteName(string bootstrap) => bootstrap switch
    {
        "arrow-counterclockwise" => "arrow-clockwise",
        "arrow-90deg-left" => "arrow-90deg-right",
        _ => bootstrap
    };

    async Task RenderIcon(string bootstrap, string library, string cssClass = null, string menuKey = null)
    {
        // Dedicated return icons already convey direction; only mirror the original BI truck.
        if (menuKey == "return-cases" && library != "BI")
        {
            cssClass = null;
        }

        <span class="comparison-icon @cssClass" aria-hidden="true">
            @if (bootstrap.HasValue())
            {
                if (library == "BI")
                {
                    string spriteName = GetSpriteName(bootstrap);
                    <bootstrap-icon name="@spriteName" flip-h="@(spriteName != bootstrap)" />
                }
                else if (menuKey != null && menuIcons.TryGetValue(menuKey, out var menuIcon))
                {
                    if (library == "HI")
                    {
                        <icon name="@menuIcon.Huge" lib="hi" />
                    }
                    else
                    {
                        <i class="hgi-stroke hgi-@(HugeFontName(menuIcon.Huge))"></i>
                    }
                }
                else if (icons.TryGetValue(bootstrap, out var icon))
                {
                    if (library == "HI")
                    {
                        <icon name="@icon.Huge" lib="hi" />
                    }
                    else
                    {
                        <i class="hgi-stroke hgi-@(HugeFontName(icon.Huge))"></i>
                    }
                }
                else
                {
                    <span title="No mapping available">?</span>
                }
            }
        </span>
    }
}

<script sm-target-zone="scripts" data-origin="IconCheatsheet">
    (() => {
        const root = document.getElementById('icon-cheatsheet');
        root.addEventListener('click', event => {
            const button = event.target.closest('[data-mute-library]');
            if (!button) return;

            const library = button.dataset.muteLibrary;
            const muted = button.getAttribute('aria-pressed') !== 'true';
            button.closest('section').querySelectorAll('[data-comparison-library]').forEach(variant => {
                if (variant.dataset.comparisonLibrary === library) {
                    variant.classList.toggle('comparison-muted', muted);
                }
            });
            button.setAttribute('aria-pressed', String(muted));
            const label = `${muted ? 'Show' : 'Mute'} ${library}`;
            button.setAttribute('aria-label', label);
            button.title = label;
            const icon = button.querySelector('i');
            icon.classList.toggle('fa-eye', !muted);
            icon.classList.toggle('fa-eye-slash', muted);
        });

        const rows = Array.from(root.querySelectorAll('[data-icon-search]'));
        document.getElementById('icon-search').addEventListener('input', event => {
            const query = event.target.value.trim().toLowerCase();
            let count = 0;
            rows.forEach(row => {
                row.hidden = !row.dataset.iconSearch.toLowerCase().includes(query);
                if (!row.hidden) count++;
            });
            root.querySelectorAll('[data-inventory-group]').forEach(group => {
                group.hidden = !Array.from(group.querySelectorAll('[data-icon-search]')).some(row => !row.hidden);
            });
            document.getElementById('icon-no-results').hidden = count > 0;
        });

        const status = document.getElementById('icon-font-status');
        Promise.all([
            document.fonts.load('16px "hugeicons-stroke-rounded"')
        ]).then(fonts => {
            const loaded = fonts.every(faces => faces.length > 0);
            status.textContent = loaded
                ? 'HugeIcons font loaded. HI uses local SVGs. BI, HI SVG and HI webfont: 16 px.'
                : 'The HugeIcons font could not be loaded. Check CDN access before comparing.';
            status.classList.toggle('text-danger', !loaded);
        }).catch(() => {
            status.textContent = 'The HugeIcons font could not be loaded. Check CDN access before comparing.';
            status.classList.add('text-danger');
        });
    })();
</script>
