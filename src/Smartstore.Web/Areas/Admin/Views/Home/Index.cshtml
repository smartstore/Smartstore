@inject Smartstore.Core.Localization.ILocalizationService DashboardLocalization

@{
    Layout = "_AdminLayout";
    Assets.BodyAttributes.AppendCssClass("admin-dashboard-layout");
    string customizeDashboardLabel = DashboardLocalization.GetResource("Admin.Dashboard.Customize", logIfNotFound: false,
        defaultValue: WorkContext.WorkingLanguage.UniqueSeoCode.EqualsNoCase("de") ? "Dashboard anpassen" : "Customize dashboard");
}

<div class="section-header">
    <div class="title">
        <icon name="home" class="d-flex" />
        @T("Admin.Dashboard.StoreStatistics")
    </div>
    <div class="options">
        <button type="button" class="btn btn-light btn-customize-dashboard">
            <icon name="dashboard-circle-settings" />
            <span>@customizeDashboardLabel</span>
        </button>
    </div>
</div>

<zone name="admin_dashboard_before"></zone>

@await Component.InvokeAsync("Dashboard", new { dashboardId = "admin-dashboard", skipUserLayout = false })

<zone name="admin_dashboard_after"></zone>
