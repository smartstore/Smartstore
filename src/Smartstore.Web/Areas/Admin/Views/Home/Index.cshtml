@using Smartstore.Admin.Models.Dashboard
@model DashboardEditorModel

@{
    Layout = "_AdminLayout";
    Assets.BodyAttributes.AppendCssClass("dashboard-page");
}

<partial name="_DashboardEditor" model="Model" />

<zone name="admin_dashboard_before"></zone>

@await Component.InvokeAsync("Dashboard", new { dashboardId = "admin-dashboard", skipUserLayout = false, prepared = Model.Dashboard })

<zone name="admin_dashboard_after"></zone>
