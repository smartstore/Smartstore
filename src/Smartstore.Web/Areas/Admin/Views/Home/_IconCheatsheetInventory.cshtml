<section aria-labelledby="icon-table-title">
    <details class="mapped-icons-details" open>
        <summary class="mb-3"><h2 id="icon-table-title" class="h4 d-inline">All mapped icons</h2></summary>
        <p class="text-muted">
            @inventory.Length source names from platform, enterprise and internal modules.
            Shared contains FA names found in both frontend and backend, exclusively.
            Aliases and observed FA styles are retained; Pro-only styles may be unavailable locally. BI is backend-only.
            HI mappings are provisional; filled and outline shapes may differ.
        </p>
        <p class="small text-muted">
            Static snapshot: 1,498 Razor views, 114 JavaScript files and the admin sitemap.
            Includes literal alternatives in dynamic bindings and editor integrations; database-driven names cannot be fully enumerated.
            Areas are inferred from views, controller areas and script bundles. Counts are source occurrences, not runtime usage.
            A dash means no source entry in that library for this row. FA: 14 px; BI, HI SVG and HI Font: 16 px.
        </p>
        <label for="icon-search" class="sr-only">Filter icons</label>
        <input id="icon-search" type="search" class="form-control mb-4" placeholder="Filter icon name, group or repository" autocomplete="off" />
        @foreach (var group in groups)
        {
            var entries = inventory.Where(x => x.Group == group).ToArray();
            var libraries = group == "Backend" ? new[] { "FA", "BI", "HI" } : new[] { "FA", "HI" };
            <section class="mb-4 d-none" data-inventory-group aria-label="@group">
                <details class="mapped-icons-details" open>
                    <summary class="mb-3"><h3 class="h5 d-inline">@group <small class="text-muted">(@entries.Length)</small></h3></summary>
                    <div class="table-responsive">
                        <table class="table table-hover comparison-table">
                            <thead>
                                <tr>
                                    @foreach (var library in libraries)
                                    {
                                        <th scope="col" class="text-center">
                                            @(library == "HI" ? "HI / HI Font" : library)
                                            <button type="button" class="comparison-mute-toggle" data-mute-library="@library"
                                                    aria-pressed="false" aria-label="@($"Mute {library}")" title="@($"Mute {library}")">
                                                <i class="far fa-eye" aria-hidden="true"></i>
                                            </button>
                                        </th>
                                    }
                                    <th scope="col">Source / mapping</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in entries)
                                {
                                    var fontName = entry.Huge == "sorting-1-9" ? "sorting-one-9" : entry.Huge;
                                    <tr data-icon-search="@($"{group} {entry.FontAwesome} {entry.Bootstrap} {entry.Huge} {entry.Sources}")">
                                        <td class="text-center" data-comparison-library="FA">
                                            @if (entry.FontAwesome.Length > 0)
                                            {
                                                var variants = entry.FontAwesome.Split('|');
                                                var name = variants[0][(variants[0].IndexOf(" fa-", StringComparison.Ordinal) + 4)..];
                                                var variantNames = string.Join("/", variants.Select(x => x[..x.IndexOf(' ')]));
                                                <span class="inventory-icon-row">
                                                    @foreach (var cssClass in variants)
                                                    {
                                                        <span class="comparison-icon" aria-hidden="true" title="@cssClass"><i class="@cssClass comparison-icon-fa"></i></span>
                                                    }
                                                </span>
                                                <code class="icon-name">@name @variantNames</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        @if (group == "Backend")
                                        {
                                            <td class="text-center" data-comparison-library="BI">
                                                @if (entry.Bootstrap.Length > 0)
                                                {
                                                    <span class="comparison-icon" aria-hidden="true"><bootstrap-icon name="@entry.Bootstrap" /></span>
                                                    <code class="icon-name">@entry.Bootstrap</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                        <td class="text-center" data-comparison-library="HI">
                                            <span class="inventory-icon-row">
                                                <span class="comparison-icon" aria-hidden="true" title="HI SVG"><icon name="@(entry.Huge + "!")" lib="hi" variant="stroke-rounded" /></span>
                                                <span class="comparison-icon" aria-hidden="true" title="HI Font"><i class="hgi-stroke hgi-@fontName"></i></span>
                                            </span>
                                            <code class="icon-name">@entry.Huge</code>
                                        </td>
                                        <td>
                                            <div class="font-weight-medium">@entry.Uses source occurrences</div>
                                            <small class="text-muted">@entry.Sources</small>
                                            <div class="small text-muted mt-1">@entry.Note</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            </section>
        }
        @{
            // Each inventory row counts one source name, independently of its FA styles.
            var sourceIcons = inventory.ToDictionary(
                x => x.Bootstrap.Length > 0
                    ? "bi:" + x.Bootstrap
                    : "fa:" + x.FontAwesome.Split('|')[0].Split(' ')[1][3..],
                x => (x.Uses, x.Group));
        }
        @await Html.PartialAsync("_IconCheatsheetMigration", sourceIcons)
        <p id="icon-no-results" class="text-muted" hidden>No matching icons.</p>
    </details>
</section>
