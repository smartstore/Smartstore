@using Smartstore.Admin.Models.Common

@model MeasureDimensionModel

@{
    var baseUnit = ViewBag.BaseDimension as MeasureDimension;
    string unspecified = T("Common.Unspecified").Value;
    bool isBaseUnit = baseUnit != null && baseUnit.Id == Model.Id;
    string baseUnitName = isBaseUnit ? Model.Name.NullEmpty() ?? unspecified : baseUnit?.Name;
    string ratioPrefix = baseUnitName.HasValue() ? $"1 {baseUnitName} =" : null;
}

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

@(Html.LocalizedEditor<MeasureDimensionModel, MeasureDimensionLocalizedModel>("measure-dimension-localized",
@<div class="adminContent">
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="Locales[item].Name" />
        </div>
        <div class="adminData">
            <input asp-for="Locales[item].LanguageId" type="hidden" />

            <input asp-for="Locales[item].Name" />
            <span asp-validation-for="Locales[item].Name"></span>
        </div>
    </div>
</div>
,
@<div class="adminContent">
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="Name" />
        </div>
        <div class="adminData">
            <input asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>
    </div>
</div>
))

<div class="adminContent">
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="SystemKeyword" />
        </div>
        <div class="adminData">
            <input asp-for="SystemKeyword" />
            <span asp-validation-for="SystemKeyword"></span>
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="Ratio" />
        </div>
        <div class="adminData">
            <editor asp-for="Ratio" sm-prefix="@ratioPrefix" sm-postfix="@Html.Encode(Model.Name.NullEmpty() ?? unspecified)" />
            <span asp-validation-for="Ratio"></span>
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="DisplayOrder" />
        </div>
        <div class="adminData">
            <editor asp-for="DisplayOrder" />
            <span asp-validation-for="DisplayOrder"></span>
        </div>
    </div>
    @if (Model.IsPrimaryDimension)
    {
        <div class="adminRow">
            <div class="adminTitle">
                <smart-label asp-for="IsPrimaryDimension" />
            </div>
            <div class="adminData">
                <input asp-for="IsPrimaryDimension" type="checkbox" readonly />
                <span asp-validation-for="IsPrimaryDimension"></span>
            </div>
        </div>
    }
    else
    {
        <div class="adminRow">
            <div class="adminTitle">
                <smart-label asp-for="IsPrimaryDimension" />
            </div>
            <div class="adminData">
                <input asp-for="IsPrimaryDimension" />
                <span asp-validation-for="IsPrimaryDimension"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle">
                &nbsp;
            </div>
            <div class="adminData">
                <div class="alert alert-warning">
                    @T("Admin.Configuration.Measures.Dimensions.Description")
                </div>
            </div>
        </div>
    }
</div>

<script sm-target-zone="scripts" sm-minify="true" data-origin="measure-unit-edit">
    $(function () {
        $('#@Html.IdFor(x => x.Name)').on('input', function () {
            const unitName = this.value.trim() || @Json.Serialize(unspecified);
            const ratioGroup = $('#@Html.IdFor(x => x.Ratio)').closest('.numberinput-group');
            ratioGroup.find('.numberinput-postfix').text(unitName);
            @if (isBaseUnit)
            {
                <text>ratioGroup.prev('.input-addon-plain').find('.input-group-text').text('1 ' + unitName + ' =');</text>
            }
        });
    });
</script>