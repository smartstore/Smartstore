@using Smartstore.Admin.Models.Orders
@model DashboardPaymentMethodsModel

@{
    var resourceKey = "Admin.Dashboard.PaymentMethods";
    var rankings = new[]
    {
        Model.PaymentMethods.OrderByDescending(x => x.OrderCount).Take(Model.Count),
        Model.PaymentMethods.OrderByDescending(x => x.TotalAmount.Amount).Take(Model.Count)
    };
    var tabNames = new[] { "quantity", "amount" };
}

<div class="report">
    <div class="report-title-row flex-wrap">
        <div class="report-title flex-grow-1 mr-3">@T(resourceKey)</div>
        <nav>
            <div class="nav btn-group" role="tablist">
                <a class="btn btn-secondary btn-dashboard nav-item active"
                   id="paymentmethods-quantity-tab" data-toggle="tab" href="#paymentmethods-quantity"
                   role="tab" aria-controls="paymentmethods-quantity" aria-selected="true">
                    @T("Admin.Dashboard.Labels.ByQuantity")
                </a>
                <a class="btn btn-secondary btn-dashboard nav-item"
                   id="paymentmethods-amount-tab" data-toggle="tab" href="#paymentmethods-amount"
                   role="tab" aria-controls="paymentmethods-amount" aria-selected="false">
                    @T("Admin.Dashboard.Labels.ByAmount")
                </a>
            </div>
        </nav>
    </div>
    <div class="tab-content" id="paymentmethods-tabcontent">
        @for (var i = 0; i < rankings.Length; i++)
        {
            <div class="tab-pane fade" attr-class='(i == 0, "show active")'
                 id="paymentmethods-@tabNames[i]" role="tabpanel" aria-labelledby="paymentmethods-@tabNames[i]-tab">
                <div class="table-responsive pb-3">
                    <table class="table table-3 small table-hover text-nowrap mb-0">
                        <thead>
                            <tr>
                                <th class="display-row">@T(resourceKey + ".Name")</th>
                                <th class="display-row text-center">@T("Admin.Dashboard.Labels.OrderCount")</th>
                                <th class="display-row text-right">@T("Common.Amount")</th>
                                <th class="display-row text-right" title="@T(resourceKey + ".FeeNotice")">@T(resourceKey + ".EstimatedFees")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in rankings[i])
                            {
                                <tr>
                                    <td class="display-row" title="@item.Name">@item.Name</td>
                                    <td class="display-row text-center" attr-class='(i == 0, "font-weight-medium")'>@item.OrderCount.ToString("N0")</td>
                                    <td class="display-row text-right" attr-class='(i == 1, "font-weight-medium")'>@item.TotalAmount</td>
                                    <td class="display-row text-right">
                                        @if (item.FeeValue.HasValue)
                                        {
                                            var feeLabel = (string)T(resourceKey + (item.FeeIsPercentage ? ".FeePercentage" : ".FixedFee"));
                                            var feeUnit = item.FeeIsPercentage ? "%" : item.TotalAmount.Currency.CurrencyCode;
                                            <span title="@feeLabel: @item.FeeValue.Value.ToString("0.##") @feeUnit">@item.EstimatedFees</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" title="@T(resourceKey + ".FeeNotConfigured")">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr sm-if="Model.PaymentMethods.Count == 0">
                                <td colspan="4" class="text-muted text-center">@T("Admin.DataGrid.NoData")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
