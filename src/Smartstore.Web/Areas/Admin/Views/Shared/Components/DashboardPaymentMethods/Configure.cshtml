@using Smartstore.Admin.Infrastructure.Dashboard
@using Microsoft.AspNetCore.Mvc.Rendering
@model PaymentMethodsDashboardWidgetSettings

@{
    ViewData["size"] = "sm";
    var resourceKey = "Admin.Dashboard.PaymentMethods.";
    var currencyCode = CommonServices.CurrencyService.PrimaryCurrency.CurrencyCode;
    var providers = (SelectListItem[])ViewBag.PaymentProviders;
}

<tabstrip id="dashboard-paymentmethods-configuration" sm-nav-style="Material">
    <tab sm-title="@T(resourceKey + "DisplaySettings")" sm-selected="true">
        <div class="form-group form-row">
            <div class="col-6">
                <smart-label class="col-form-label col-form-label-sm" asp-for="Count" />
            </div>
            <div class="col-6">
                <input sm-control-size="Small" asp-for="Count" type="number" sm-numberinput-group-class="overflow-visible" min="1" max="50" step="1" placeholder="10" required />
                <span asp-validation-for="Count"></span>
            </div>
        </div>
    </tab>
    <tab sm-title="@T(resourceKey + "FeeSettings")">
        <p class="text-muted">@T(resourceKey + "FeeNotice")</p>

        @foreach (var provider in providers)
        {
            var systemName = provider.Value;
            Model.Fees.TryAdd(systemName, new Amount { Value = 0, Unit = "%" });
            <div class="form-group form-row">
                <div class="col-6">
                    <smart-label class="col-form-label col-form-label-sm" asp-for="Fees[systemName]" sm-text="@provider.Text" />
                </div>
                <div class="col-6">
                    <editor asp-for="Fees[systemName]"
                            asp-additional-viewdata='new { units = new[] { currencyCode, "%" }, min = 0, max = 1000000, placeholder = "0" }'
                            required="required" />
                    <span asp-validation-for="Fees[systemName].Value"></span>
                    <span asp-validation-for="Fees[systemName].Unit"></span>
                </div>
            </div>
        }

        <p sm-if="providers.Length == 0" class="text-muted">@T("Admin.DataGrid.NoData")</p>
    </tab>
</tabstrip>
