@using Smartstore.Core.Stores;
@using Smartstore.Core.Packaging;

@{
    var currentCustomer = this.WorkContext.CurrentCustomer;
    var currentLanguage = this.WorkContext.WorkingLanguage;
    var stores = ((ICollection<Store>)ViewBag.Stores) ?? new List<Store>();
    string currentLanguageCode = currentLanguage.UniqueSeoCode.EmptyNull().ToLower();
    string communityUrl = (currentLanguageCode == "de" ?
        "http://community.smartstore.com" :
        "http://community.smartstore.com/index.php?/&k=880ea6a14ea49e853634fbdc5015a024&setlanguage=1&cal_id=&langid=1");
    string docsUrl = Display.GenerateHelpUrl("");
    var checkUpdateResult = ViewBag.CheckUpdateResult as CheckUpdateResult;
    string expandSidebarLabel = T("Admin.Header.ExpandNavigation");
    string collapseSidebarLabel = T("Admin.Header.CollapseNavigation");
    string collapseSidebarText = T("Admin.Header.CollapseNavigation.Short");
}

<link sm-target-zone="head_links" as="image" rel="preload" href="~/images/smartstore.svg" />

<nav id="navbar" class="navbar navbar-slide navbar-dark navbar-expand navbar-sidebar" data-submenu-back-label="@T("Common.Back")" data-expand-label="@expandSidebarLabel" data-collapse-label="@collapseSidebarLabel">
    <a class="navbar-brand" asp-action="Index" asp-controller="Home" asp-area="Admin">
        <span class="navbar-brand-symbol">
            <img src="~/images/smartstore.svg" alt="Smartstore" width="140" height="25" />
        </span>
        <span class="navbar-brand-wordmark" aria-hidden="true">
            <img src="~/images/smartstore.svg" alt="" width="140" height="25" />
        </span>
    </a>

    <div id="navbar-menu" class="navbar-collapse">
        <zone name="admin_menu_before"></zone>
        <menu name="Admin" template="Admin" />
        <zone name="admin_menu_after"></zone>
    </div>

    <div class="navbar-footer">
        <button id="navbar-mobile-close" type="button" class="navbar-sidebar-toggle nav-link d-sm-none" aria-label="@T("Common.Close")">
            <icon name="close" class="navbar-icon" />
            <span class="navbar-label" aria-hidden="true">@T("Common.Close")</span>
        </button>
        <button id="navbar-sidebar-toggle" type="button" class="navbar-sidebar-toggle nav-link d-none d-sm-flex"
                aria-controls="navbar-menu" aria-expanded="false" aria-label="@expandSidebarLabel" title="@expandSidebarLabel">
            <icon name="sidebar-expand" class="navbar-icon navbar-toggle-expand" />
            <icon name="sidebar-collapse" class="navbar-icon navbar-toggle-collapse" />
            <span class="navbar-label" aria-hidden="true">@collapseSidebarText</span>
        </button>

        <div class="navbar-account">
            <div class="nav-item dropdown">
                <button id="current-user" type="button" class="nav-link dropdown-toggle"
                        data-toggle="dropdown" title="@T("Admin.Common.Actions")" aria-label="@T("Admin.Common.Actions")" aria-haspopup="true" aria-expanded="false">
                    <icon name="gear" class="navbar-icon" />
                    <span class="navbar-label" aria-hidden="true">@T("Admin.Common.Actions")</span>
                    <span sm-if="checkUpdateResult != null && checkUpdateResult.UpdateAvailable" class="reddot"></span>
                </button>
                <div class="dropdown-menu dropdown-menu-compact dropdown-menu-light-icons">
                    <div class="dropdown-group">
                        <button type="button" class="dropdown-item" aria-haspopup="true" aria-expanded="false" aria-controls="account-shops-menu">
                            <icon name="store" class="icon-fw" />
                            @T("Admin.Common.Stores")
                        </button>
                        <div id="account-shops-menu" class="dropdown-menu">
                            @foreach (var store in stores)
                            {
                                <a class="dropdown-item" href="@store.GetBaseUrl()" title="@T("Admin.Header.PublicStore") - @store.Name">
                                    <icon name="store" class="icon-fw" />
                                    @store.Name.Truncate(32, "…")
                                </a>
                            }
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='@Url.Action("Preview", "Theme")'>
                                <icon name="eye" class="icon-fw" />
                                @T("Admin.Configuration.Themes.PreviewMode")
                            </a>
                        </div>
                    </div>
                    @await Component.InvokeAsync("AdminLanguageSelector")
                    <div class="dropdown-group">
                        <button type="button" class="dropdown-item" aria-haspopup="true" aria-expanded="false" aria-controls="account-help-menu">
                            <icon name="question-circle" class="icon-fw" />
                            @T("Admin.Help")
                        </button>
                        <div id="account-help-menu" class="dropdown-menu">
                            <a class="dropdown-item" href="@docsUrl" data-lang="@currentLanguageCode" target="help">
                                <icon name="question-circle" class="icon-fw" />
                                @T("Admin.Help.Documentation")
                            </a>
                            <a class="dropdown-item" href="@communityUrl" data-lang="@currentLanguageCode" target="help">
                                <icon name="comment" class="icon-fw" />
                                @T("Admin.Help.Forums")
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-action="About" asp-controller="Home">
                                <icon name="info-circle" class="icon-fw" />
                                @T("Admin.Common.About")
                            </a>
                        </div>
                    </div>
                    <div class="dropdown-divider"></div>
                    @if (currentCustomer != null && currentCustomer.IsRegistered())
                    {
                        <a class="dropdown-item" asp-action="Edit" asp-controller="Customer" asp-route-id="@currentCustomer.Id">
                            <icon name="user-circle" class="icon-fw" />
                            <span>@T("Admin.Header.Account")</span>
                            <small class="navbar-account-name text-muted text-truncate ml-auto" title="@currentCustomer.Username">@currentCustomer.Username</small>
                        </a>
                    }
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" id="clear-cache" href="javascript:;" data-url="@Url.Action("ClearCache", "Maintenance", new { area = "Admin", silent = true })">
                        <icon name="clean" class="icon-fw" />
                        @T("Admin.Header.ClearCache")
                    </a>
                    <a class="dropdown-item" id="clear-database-cache" href="javascript:;" data-url="@Url.Action("ClearDatabaseCache", "Maintenance", new { area = "Admin", silent = true })">
                        <icon name="database-sync-01" class="icon-fw" />
                        @T("Admin.Header.ClearDbCache")
                    </a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" asp-action="RestartApplication" asp-controller="Maintenance" asp-area="Admin">
                        <icon name="power" class="icon-fw" />
                        @T("Admin.Header.RestartApplication")
                    </a>
                    @if (checkUpdateResult != null && checkUpdateResult.UpdateAvailable)
                    {
                        <a class="dropdown-item" asp-controller="Maintenance" asp-action="CheckUpdate">
                            <icon name="arrow-turn-up" class="icon-fw" />
                            <strong>@T("Admin.CheckUpdate.UpdateAvailable")</strong>
                            <span class="reddot" style="margin-left: 6px"></span>
                        </a>
                    }
                    @if (currentCustomer != null && currentCustomer.IsRegistered())
                    {
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" asp-route="Logout">
                            <icon name="logout" class="icon-fw" />
                            @T("Admin.Header.Logout")
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</nav>
