@{
    Layout = "_AdminLayout";
    Assets.BodyAttributes.AppendCssClass("admin-settings-layout");
}

<div class="settings-shell">
    <nav class="settings-navigation d-none d-md-flex" aria-label="@T("Admin.Configuration.Settings")">
        <menu name="Settings" template="Settings" />
    </nav>
    <div class="settings-content spa-stretch">
        @* Mobile menu *@
        <div class="d-md-none overflow-auto">
            <div class="card nav-collapsible mb-3">
                <div class="card-header p-3 bg-white nav-toggler collapsed" data-toggle="collapse" data-target="#settings-menu" aria-controls="settings-menu" aria-expanded="false">
                    <h6 class="card-title m-0 hstack gap-1">
                        <icon name="bars" />
                        <span>@T("Common.Menu")</span>
                    </h6>
                </div>
                <div id="settings-menu" class="collapse nav-collapse p-2">
                    <menu name="Settings" template="Settings" />
                </div>
            </div>
        </div>
        @RenderBody()
    </div>
</div>
