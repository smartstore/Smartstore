@model object

@{
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty);
    var id = Html.GenerateIdFromName(name);
    var landscapePresets = new[]
    {
        (Value: 0.5m, Label: "2:1"),
        (Value: 0.5625m, Label: "16:9"),
        (Value: 0.6667m, Label: "3:2"),
        (Value: 0.75m, Label: "4:3")
    };
    var portraitPresets = new[]
    {
        (Value: 1.3333m, Label: "3:4"),
        (Value: 1.5m, Label: "2:3"),
        (Value: 1.7778m, Label: "9:16"),
        (Value: 2m, Label: "1:2"),
        (Value: 3m, Label: "1:3")
    };
}

<div id="swatch-aspect-ratio-@id" class="row xs-gutters swatch-aspect-ratio-editor">
    <div class="col">
        <partial name="~/Views/Shared/EditorTemplates/Range.cshtml" model="@Model" view-data="ViewData" />
    </div>
    <div class="col-auto">
        <div class="d-flex align-items-start">
            <div class="dropdown">
                <button type="button"
                        class="btn btn-sm btn-light btn-flat btn-no-border btn-icon dropdown-toggle no-chevron"
                        data-toggle="dropdown"
                        title="@ViewData.ModelMetadata.GetDisplayName()"
                        aria-label="@ViewData.ModelMetadata.GetDisplayName()"
                        aria-haspopup="true">
                    <bootstrap-icon name="aspect-ratio" />
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    @foreach (var preset in landscapePresets)
                    {
                        <button type="button" class="dropdown-item swatch-aspect-ratio-preset" data-value="@preset.Value.ToStringInvariant()">
                            @preset.Label
                        </button>
                    }
                    <div class="dropdown-divider"></div>
                    <button type="button" class="dropdown-item swatch-aspect-ratio-preset" data-value="1">
                        1:1
                    </button>
                    <div class="dropdown-divider"></div>
                    @foreach (var preset in portraitPresets)
                    {
                        <button type="button" class="dropdown-item swatch-aspect-ratio-preset" data-value="@preset.Value.ToStringInvariant()">
                            @preset.Label
                        </button>
                    }
                </div>
            </div>
            <div class="ml-2" style="width: 20px; height: 60px;">
                <div class="swatch-aspect-ratio-preview"
                     style="width: 20px; background-color: var(--gray-600); transition: height 0.08s linear;"></div>
            </div>
        </div>
    </div>
</div>

<script sm-target-zone="scripts" data-origin="swatch-aspect-ratio-template">
    $(function() {
        const $container = $('#swatch-aspect-ratio-@id');
        const $range = $container.find('.form-control-range');
        const $preview = $container.find('.swatch-aspect-ratio-preview');
        const $presets = $container.find('.swatch-aspect-ratio-preset');

        function updatePreview() {
            let val = parseFloat($range.val());
            if (isNaN(val) || val <= 0) {
                val = 1;
            }

            const previewWidth = parseFloat($preview.css('width'));
            $preview.css('height', (previewWidth * val) + 'px');

            $presets.each((_, element) => {
                const $preset = $(element);
                const isActive = Math.abs(parseFloat($preset.data('value')) - val) < 0.00005;
                $preset.toggleClass('active', isActive);
            });
        }

        $range.on('input change', updatePreview);
        $presets.on('click', (e) => {
            $range.val($(e.currentTarget).data('value')).trigger('input').trigger('change');
        });
        $container.on('click', '.range-reset', () => setTimeout(updatePreview));

        updatePreview();
    });
</script>
