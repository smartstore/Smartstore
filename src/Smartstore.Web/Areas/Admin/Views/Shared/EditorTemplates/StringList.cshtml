@using Smartstore.Utilities

@model string[]

@{
    var minItems = Math.Max(0, GetMetadata<int>("minItems", 0));
    var maxItems = Math.Max(minItems, GetMetadata<int>("maxItems", int.MaxValue));
    var maxLength = GetMetadata<int>("maxLength", 0);
    var sortable = GetMetadata<bool>("sortable", false);
    var readOnly = GetMetadata<bool>("readOnly", false);
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty);
    var id = Html.GenerateIdFromName(name);
    var items = Model ?? [];
    var newItem = string.Empty;
    var label = ViewData.ModelMetadata.GetDisplayName();
    var attributes = new AttributeDictionary()
        .Merge(ConvertUtility.ObjectToDictionary(ViewData["htmlAttributes"] ?? new object()));

    if (maxLength > 0)
    {
        attributes.Merge("maxlength", maxLength.ToStringInvariant(), true);
    }

    if (readOnly)
    {
        attributes.Merge("readonly", "readonly", true);
    }
}

<div id="string-list-@id" class="string-list edit-control"
     data-editor="string-list" data-field-name="@name" data-field-id="@id" data-field-label="@label"
     data-min-items="@minItems" data-max-items="@maxItems" data-read-only='@(readOnly ? "true" : "false")'>
    <div class="string-list-empty text-muted mb-2" attr-class='(items.Length > 0 || minItems > 0, "d-none")' role="status">
        @T("Common.ListIsEmpty")
    </div>
    <div class="string-list-items">
        @for (var i = 0; i < items.Length; i++)
        {
            <div class="string-list-item row flex-nowrap g-2 mb-2">
                <div class="col">
                    <div class="input-group flex-nowrap">
                        <input asp-for="@Model[i]" attrs="attributes" type="text" class="string-list-value"
                               id="@(i == 0 ? id : id + "_" + i)" aria-label="@(label + " " + (i + 1))" />
                        <div sm-if="sortable" class="input-group-append">
                            <button type="button" class="btn btn-secondary btn-icon string-list-up" title="@T("Common.MoveUp")" disabled="@readOnly">
                                <icon name="arrow-up" />
                            </button>
                            <button type="button" class="btn btn-secondary btn-icon string-list-down" title="@T("Common.MoveDown")" disabled="@readOnly">
                                <icon name="arrow-down" />
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary btn-icon string-list-remove" title="@T("Common.Remove")" disabled="@readOnly">
                        <icon name="close" />
                    </button>
                </div>
            </div>
        }
    </div>
    <button type="button" class="btn btn-light string-list-add" disabled="@readOnly">
        <icon name="plus" />
        <span>@T("Common.AddNew")</span>
    </button>
    <template class="string-list-template">
        <div class="string-list-item row flex-nowrap g-2 mb-2">
            <div class="col">
                <div class="input-group flex-nowrap">
                    <input asp-for="@newItem" attrs="attributes" type="text" class="string-list-value" id="@(id)_template" />
                    <div sm-if="sortable" class="input-group-append">
                        <button type="button" class="btn btn-secondary btn-icon string-list-up" title="@T("Common.MoveUp")">
                            <icon name="arrow-up" />
                        </button>
                        <button type="button" class="btn btn-secondary btn-icon string-list-down" title="@T("Common.MoveDown")">
                            <icon name="arrow-down" />
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-secondary btn-icon btn-to-danger string-list-remove" title="@T("Common.Remove")">
                    <icon name="close" />
                </button>
            </div>
        </div>
    </template>
</div>
<script src="~/js/smartstore.stringlist.js" asp-append-version="true" sm-target-zone="scripts" sm-key="stringlist"></script>
