@using Smartstore.Admin.Models.Maintenance

@model IList<SystemWarningModel>

@{
    ViewBag.Title = T("Admin.System.Warnings").Value;
}

<div class="section-header">
    <div class="title">
        <icon name="alert-circle" />
        @T("Admin.System.Warnings")
    </div>
</div>

<div class="system-warnings fs-h6">
    <ul class="icon-ul">
        @foreach (var warning in Model)
        {
            <li class="pb-2">
                @switch (warning.Level)
                {
                    case SystemWarningLevel.Pass:
                        {
                            <icon name="check" class="icon-li text-success" />
                            <span>@Html.Raw(warning.Text)</span>
                        }
                        break;
                    case SystemWarningLevel.Warning:
                        {
                            <icon name="question-circle" class="icon-li text-success" />
                            <span class="fwm">@Html.Raw(warning.Text)</span>
                        }
                        break;
                    case SystemWarningLevel.Fail:
                        {
                            <icon name="warning" class="icon-li text-danger" />
                            <span class="fwm text-danger">@Html.Raw(warning.Text)</span>
                        }
                        break;
                }
            </li>
        }
    </ul>
</div>

