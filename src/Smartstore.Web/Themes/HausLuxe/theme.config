<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="HausLuxe" description="Luxury storefront theme inspired by classic European boutique design" author="HausLuxe" version="1.0">

    <Vars>
        <!-- Brand palette -->
        <Var name="gray-100" type="Color">#f7f3ee</Var>
        <Var name="gray-200" type="Color">#efe5d9</Var>
        <Var name="gray-300" type="Color">#e0d4c4</Var>
        <Var name="gray-400" type="Color">#c9b79d</Var>
        <Var name="gray-500" type="Color">#9b8d7b</Var>
        <Var name="gray-600" type="Color">#6d625a</Var>
        <Var name="gray-700" type="Color">#4c453f</Var>
        <Var name="gray-800" type="Color">#2f2b29</Var>
        <Var name="gray-900" type="Color">#1b1817</Var>

        <Var name="gold" type="Color">#b88b4a</Var>
        <Var name="sand" type="Color">#d9c1a0</Var>
        <Var name="olive" type="Color">#5a6b58</Var>
        <Var name="moss" type="Color">#7a8f78</Var>
        <Var name="rose" type="Color">#a7705f</Var>
        <Var name="charcoal" type="Color">#1d1b1a</Var>

        <Var name="primary" type="Color">$gold</Var>
        <Var name="secondary" type="Color">$gray-700</Var>
        <Var name="success" type="Color">$olive</Var>
        <Var name="danger" type="Color">$rose</Var>
        <Var name="warning" type="Color">$sand</Var>
        <Var name="info" type="Color">$gray-600</Var>
        <Var name="light" type="Color">#f8f4ef</Var>
        <Var name="dark" type="Color">$charcoal</Var>
        <Var name="brand-colors" type="String">primary,secondary,success,danger,warning,info,light,gray,dark</Var>

        <!-- Layout -->
        <Var name="boxed" type="Boolean">false</Var>
        <Var name="border-radius" type="String">0.5rem</Var>
        <Var name="border-radius-sm" type="String">0.375rem</Var>
        <Var name="border-radius-lg" type="String">0.75rem</Var>
        <Var name="border-radius-xl" type="String">1rem</Var>
        <Var name="border-radius-xxl" type="String">1.5rem</Var>

        <!-- Site colors -->
        <Var name="site-bg" type="Color">#f4efe9</Var>
        <Var name="body-bg" type="Color">#fffdfb</Var>
        <Var name="body-color" type="Color">#1f1a17</Var>
        <Var name="yiq-text-dark" type="Color">#1b1817</Var>
        <Var name="yiq-text-light" type="Color">#fff</Var>
        <Var name="body-secondary-color" type="Color">#6d625a</Var>
        <Var name="body-tertiary-color" type="Color">#9b8d7b</Var>
        <Var name="text-muted" type="Color">$body-secondary-color</Var>
        <Var name="link-color" type="Color">#8d6a3f</Var>
        <Var name="btn-secondary-bg" type="Color">#fff</Var>

        <!-- Typography -->
        <Var name="font-family-sans-serif" type="String">"Segoe UI", "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="font-family-monospace" type="String">Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace</Var>
        <Var name="font-size-base" type="String">0.9375rem</Var>
        <Var name="font-size-lg" type="String">1rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="font-weight-light" type="String">300</Var>
        <Var name="font-weight-normal" type="String">normal</Var>
        <Var name="font-weight-medium" type="String">600</Var>
        <Var name="font-weight-bold" type="String">700</Var>
        <Var name="headings-font-family" type="String">Georgia, "Times New Roman", serif</Var>
        <Var name="headings-font-weight" type="String">600</Var>
        <Var name="headings-line-height" type="String">1.2</Var>
        <Var name="headings-color" type="String">$gray-900</Var>
        <Var name="lead-font-weight" type="String">400</Var>
        <Var name="h1-font-size" type="String">2.5rem</Var>
        <Var name="h2-font-size" type="String">2rem</Var>
        <Var name="h3-font-size" type="String">1.6rem</Var>
        <Var name="h4-font-size" type="String">1.3rem</Var>
        <Var name="h5-font-size" type="String">1rem</Var>
        <Var name="h6-font-size" type="String">0.9rem</Var>

        <!-- Header -->
        <Var name="header-bg" type="Color">#fffdfb</Var>
        <Var name="header-color" type="Color">#1f1a17</Var>
        <Var name="header-color-muted" type="Color">#6d625a</Var>
        <Var name="inverse-menubar" type="Boolean">false</Var>
        <Var name="inverse-shopbar" type="Boolean">false</Var>
        <Var name="inverse-navbar" type="Boolean">false</Var>
        <Var name="menubar-bg" type="Color">transparent</Var>
        <Var name="shopbar-bg" type="Color">#1b1817</Var>
        <Var name="megamenu-bg" type="Color">#f7f3ee</Var>
        <Var name="menubar-color" type="Color">#1f1a17</Var>
        <Var name="shopbar-color" type="Color">#f7f3ee</Var>
        <Var name="megamenu-color" type="Color">#1f1a17</Var>

        <!-- Footer -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#1b1917</Var>
        <Var name="footer-color" type="Color">#f3eee7</Var>
        <Var name="footer-color-muted" type="Color">rgba(255,255,255,0.7)</Var>
        <Var name="footer-inverse-color" type="Color">#fff</Var>
        <Var name="footer-inverse-color-muted" type="Color">rgba(255,255,255,0.72)</Var>
        <Var name="footer-social-bg" type="Color">rgba(255,255,255,0.08)</Var>
        <Var name="footer-social-color" type="Color">#f3eee7</Var>

        <!-- Search -->
        <Var name="searchbox-shadow" type="Boolean">true</Var>
        <Var name="searchbox-bg-1" type="Color">#f5efe8</Var>
        <Var name="searchbox-bg-2" type="Color">#f8f4ef</Var>
        <Var name="searchbox-bg-mobile" type="Color">#f5efe8</Var>
        <Var name="searchbox-color-1" type="Color">#1f1a17</Var>
        <Var name="searchbox-color-2" type="Color">#6d625a</Var>
        <Var name="searchbox-border-1" type="Color">#d7c8b5</Var>
        <Var name="searchbox-border-2" type="Color">#d7c8b5</Var>
        <Var name="searchbox-border-mobile" type="Color">#d7c8b5</Var>
        <Var name="searchbox-outline-width" type="String">1px</Var>
        <Var name="searchbox-outline-color" type="Color">$primary</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$gold</Var>

        <!-- Buttons -->
        <Var name="btn-primary-bg" type="Color">$gold</Var>
        <Var name="btn-primary-border" type="Color">$gold</Var>
        <Var name="btn-primary-color" type="Color">#fff</Var>
        <Var name="btn-link-color" type="Color">$link-color</Var>

        <!-- Cards and surfaces -->
        <Var name="card-cap-bg" type="Color">#f6f0ea</Var>
        <Var name="input-bg" type="Color">#fff</Var>
        <Var name="input-border-color" type="Color">#dccbb8</Var>
        <Var name="dropdown-bg" type="Color">#fffdfb</Var>
        <Var name="dropdown-border-color" type="Color">#e4d9cb</Var>
        <Var name="dropdown-link-color" type="Color">$body-color</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#f5efe8</Var>

        <!-- Other misc -->
        <Var name="badge-content-shift" type="String">-1px</Var>
    </Vars>
</Theme>
