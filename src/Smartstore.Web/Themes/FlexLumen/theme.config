<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Lumen" description="A bright white canvas with iris-blue actions, soft lavender surfaces and petrol accents. Familiar, airy and quietly modern." author="SmartStore AG" version="1.0">
    <Vars>
        <!-- A white canvas with cool, neutral typography. -->
        <Var name="gray-100" type="Color">#f6f7fb</Var>
        <Var name="gray-200" type="Color">#e9ecf3</Var>
        <Var name="gray-300" type="Color">#d6dce8</Var>
        <Var name="gray-400" type="Color">#adb7c9</Var>
        <Var name="gray-500" type="Color">#8290a8</Var>
        <Var name="gray-600" type="Color">#606f87</Var>
        <Var name="gray-700" type="Color">#45536b</Var>
        <Var name="gray-800" type="Color">#2e3b51</Var>
        <Var name="gray-900" type="Color">#18243a</Var>
        <Var name="primary" type="Color">#4b50c8</Var>
        <Var name="secondary" type="Color">#176b70</Var>
        <Var name="success" type="Color">#237c59</Var>
        <Var name="danger" type="Color">#c03959</Var>
        <Var name="warning" type="Color">#95620d</Var>
        <Var name="info" type="Color">#266caa</Var>
        <Var name="light" type="Color">#f6f7fb</Var>
        <Var name="dark" type="Color">$gray-900</Var>
        <Var name="boxed" type="Boolean">false</Var>
        <Var name="site-bg" type="Color">#ffffff</Var>
        <Var name="body-bg" type="Color">#ffffff</Var>
        <Var name="body-color" type="Color">$gray-800</Var>
        <Var name="body-secondary-color" type="Color">$gray-600</Var>
        <Var name="body-tertiary-color" type="Color">$gray-500</Var>
        <Var name="yiq-text-dark" type="Color">$gray-900</Var>
        <Var name="link-color" type="Color">$primary</Var>
        <Var name="btn-secondary-bg" type="Color">#edf1fa</Var>

        <!-- Familiar system typography with softer, compact geometry. -->
        <Var name="font-family-sans-serif" type="String">"Segoe UI", "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="font-size-base" type="String">1rem</Var>
        <Var name="font-size-lg" type="String">1.125rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="font-weight-medium" type="String">600</Var>
        <Var name="headings-font-family" type="String">"Segoe UI", "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="headings-font-weight" type="String">600</Var>
        <Var name="headings-line-height" type="String">1.2</Var>
        <Var name="headings-color" type="String">$gray-900</Var>
        <Var name="h1-font-size" type="String">2.5rem</Var>
        <Var name="h2-font-size" type="String">2rem</Var>
        <Var name="h3-font-size" type="String">1.5rem</Var>
        <Var name="h4-font-size" type="String">1.25rem</Var>
        <Var name="prose-font-size" type="String">1.0625rem</Var>
        <Var name="prose-line-height" type="String">1.65</Var>
        <Var name="prose-headings-lg-font-weight" type="String">600</Var>
        <Var name="prose-headings-sm-font-weight" type="String">600</Var>
        <Var name="badge-content-shift" type="String">0px</Var>
        <Var name="border-radius" type="String">0.5rem</Var>
        <Var name="border-radius-sm" type="String">0.25rem</Var>
        <Var name="border-radius-lg" type="String">0.875rem</Var>
        <Var name="border-radius-xl" type="String">1.25rem</Var>
        <Var name="border-radius-xxl" type="String">1.5rem</Var>

        <!-- Light navigation with a subtle lavender service strip. -->
        <Var name="header-bg" type="Color">#ffffff</Var>
        <Var name="header-color" type="Color">$gray-900</Var>
        <Var name="header-color-muted" type="Color">$gray-600</Var>
        <Var name="menubar-bg" type="Color">#f0f0fc</Var>
        <Var name="menubar-color" type="Color">#414783</Var>
        <Var name="shopbar-bg" type="Color">#ffffff</Var>
        <Var name="shopbar-color" type="Color">$gray-900</Var>
        <Var name="inverse-menubar" type="Boolean">false</Var>
        <Var name="inverse-shopbar" type="Boolean">false</Var>
        <Var name="inverse-navbar" type="Boolean">false</Var>
        <Var name="megamenu-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-color" type="Color">$gray-800</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-heading-color" type="Color">$primary</Var>
        <Var name="megamenu-subitem-color" type="Color">$gray-600</Var>
        <Var name="megamenu-text-color" type="Color">$body-color</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- A quiet search field and tinted supporting surfaces. -->
        <Var name="searchbox-pill" type="Boolean">true</Var>
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-color" type="Color">$primary</Var>
        <Var name="searchbox-bg-1" type="Color">#f6f7fb</Var>
        <Var name="searchbox-bg-2" type="Color">#ffffff</Var>
        <Var name="searchbox-bg-mobile" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-color-1" type="Color">$gray-800</Var>
        <Var name="searchbox-color-2" type="Color">$gray-900</Var>
        <Var name="searchbox-border-1" type="Color">$gray-200</Var>
        <Var name="searchbox-border-2" type="Color">$primary</Var>
        <Var name="searchbox-border-mobile" type="Color">$searchbox-border-1</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$primary</Var>
        <Var name="card-bg" type="Color">#ffffff</Var>
        <Var name="card-cap-bg" type="Color">#f6f7fb</Var>
        <Var name="card-border-color" type="Color">$gray-200</Var>
        <Var name="dropdown-bg" type="Color">#ffffff</Var>
        <Var name="dropdown-link-color" type="Color">$gray-800</Var>
        <Var name="dropdown-link-hover-color" type="Color">$primary</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#f0f0fc</Var>
        <Var name="nav-tabs-active-link-color" type="Color">$primary</Var>
        <Var name="product-price-color" type="Color">$gray-900</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#f3f3fc</Var>
        <Var name="register-box-bg" type="Color">#edf7f5</Var>
        <Var name="cart-footer-bg" type="Color">#f3f3fc</Var>
        <Var name="costep-progress-color" type="Color">$primary</Var>
        <Var name="art-active-bg-color" type="Color">#ffffff</Var>
        <Var name="art-active-border-color" type="Color">$gray-300</Var>

        <!-- A bright footer that stays part of the white page. -->
        <Var name="inverse-footer" type="Boolean">false</Var>
        <Var name="footer-bg" type="Color">#f6f7fb</Var>
        <Var name="footer-color" type="Color">$gray-900</Var>
        <Var name="footer-color-muted" type="Color">$gray-600</Var>
        <Var name="footer-social-bg" type="Color">#e9ecf3</Var>
        <Var name="footer-social-color" type="Color">$secondary</Var>
    </Vars>
</Theme>
