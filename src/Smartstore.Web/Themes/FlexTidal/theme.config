<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Tidal" description="Atlantic ink, vivid coral and glacial blue. Crisp typography, clean geometry and bright product surfaces." author="SmartStore AG" version="1.0">
    <Vars>
        <!-- Cool slate neutrals. -->
        <Var name="gray-100" type="Color">#f0f5f7</Var>
        <Var name="gray-200" type="Color">#e1eaee</Var>
        <Var name="gray-300" type="Color">#c8d7df</Var>
        <Var name="gray-400" type="Color">#a5bac6</Var>
        <Var name="gray-500" type="Color">#7e98a8</Var>
        <Var name="gray-600" type="Color">#526e80</Var>
        <Var name="gray-700" type="Color">#385368</Var>
        <Var name="gray-800" type="Color">#233e52</Var>
        <Var name="gray-900" type="Color">#102c40</Var>

        <!-- Coral actions against Atlantic blue; restrained status colors. -->
        <Var name="primary" type="Color">#c64432</Var>
        <Var name="secondary" type="Color">#164b65</Var>
        <Var name="success" type="Color">#24745e</Var>
        <Var name="danger" type="Color">#b82e54</Var>
        <Var name="warning" type="Color">#a56612</Var>
        <Var name="info" type="Color">#287696</Var>
        <Var name="light" type="Color">#edf6fa</Var>
        <Var name="dark" type="Color">$gray-900</Var>

        <!-- White product canvas framed by cool supporting surfaces. -->
        <Var name="boxed" type="Boolean">false</Var>
        <Var name="site-bg" type="Color">#edf6fa</Var>
        <Var name="body-bg" type="Color">#ffffff</Var>
        <Var name="body-color" type="Color">$gray-800</Var>
        <Var name="body-secondary-color" type="Color">$gray-600</Var>
        <Var name="body-tertiary-color" type="Color">$gray-500</Var>
        <Var name="yiq-text-dark" type="Color">$gray-900</Var>
        <Var name="link-color" type="Color">$secondary</Var>
        <Var name="btn-secondary-bg" type="Color">#edf6fa</Var>

        <!-- Confident sans-serif headings; no external font dependency. -->
        <Var name="font-family-sans-serif" type="String">"Segoe UI", "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="font-size-base" type="String">1rem</Var>
        <Var name="font-size-lg" type="String">1.125rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="font-weight-medium" type="String">600</Var>
        <Var name="headings-font-family" type="String">"Arial", "Helvetica Neue", sans-serif</Var>
        <Var name="headings-font-weight" type="String">700</Var>
        <Var name="headings-line-height" type="String">1.1</Var>
        <Var name="headings-color" type="String">$gray-900</Var>
        <Var name="h1-font-size" type="String">2.75rem</Var>
        <Var name="h2-font-size" type="String">2rem</Var>
        <Var name="h3-font-size" type="String">1.5rem</Var>
        <Var name="h4-font-size" type="String">1.25rem</Var>
        <Var name="prose-font-size" type="String">1.0625rem</Var>
        <Var name="prose-line-height" type="String">1.65</Var>
        <Var name="prose-headings-lg-font-weight" type="String">700</Var>
        <Var name="prose-headings-sm-font-weight" type="String">600</Var>

        <!-- Sharper geometry, without completely square controls. -->
        <Var name="border-radius" type="String">0.25rem</Var>
        <Var name="border-radius-sm" type="String">0.1875rem</Var>
        <Var name="border-radius-lg" type="String">0.5rem</Var>
        <Var name="border-radius-xl" type="String">0.75rem</Var>
        <Var name="border-radius-xxl" type="String">1rem</Var>

        <!-- A dark masthead, pale blue service strip and bright navigation. -->
        <Var name="header-bg" type="Color">$gray-900</Var>
        <Var name="header-color" type="Color">#ffffff</Var>
        <Var name="header-color-muted" type="Color">#c8d7df</Var>
        <Var name="menubar-bg" type="Color">#dceef5</Var>
        <Var name="menubar-color" type="Color">$gray-900</Var>
        <Var name="shopbar-bg" type="Color">$gray-900</Var>
        <Var name="inverse-menubar" type="Boolean">false</Var>
        <Var name="inverse-shopbar" type="Boolean">true</Var>
        <Var name="shopbar-inverse-color" type="Color">#ffffff</Var>
        <Var name="inverse-navbar" type="Boolean">false</Var>
        <Var name="megamenu-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-color" type="Color">$gray-900</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-heading-color" type="Color">$primary</Var>
        <Var name="megamenu-subitem-color" type="Color">$gray-600</Var>
        <Var name="megamenu-text-color" type="Color">$body-color</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- A bright, compact search field within the dark masthead. -->
        <Var name="searchbox-pill" type="Boolean">false</Var>
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-color" type="Color">#ff917c</Var>
        <Var name="searchbox-bg-1" type="Color">#edf6fa</Var>
        <Var name="searchbox-bg-2" type="Color">#ffffff</Var>
        <Var name="searchbox-bg-mobile" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-color-1" type="Color">$gray-900</Var>
        <Var name="searchbox-color-2" type="Color">$gray-900</Var>
        <Var name="searchbox-border-1" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-border-2" type="Color">$primary</Var>
        <Var name="searchbox-border-mobile" type="Color">$searchbox-border-1</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$primary</Var>

        <!-- Ice-blue panels and a warm tint around registration. -->
        <Var name="card-bg" type="Color">#ffffff</Var>
        <Var name="card-cap-bg" type="Color">#edf6fa</Var>
        <Var name="card-border-color" type="Color">$gray-200</Var>
        <Var name="dropdown-bg" type="Color">#ffffff</Var>
        <Var name="dropdown-link-color" type="Color">$gray-900</Var>
        <Var name="dropdown-link-hover-color" type="Color">$primary</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#fff0eb</Var>
        <Var name="nav-tabs-active-link-color" type="Color">$primary</Var>
        <Var name="product-price-color" type="Color">$gray-900</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#edf6fa</Var>
        <Var name="register-box-bg" type="Color">#fff0eb</Var>
        <Var name="cart-footer-bg" type="Color">#edf6fa</Var>
        <Var name="costep-progress-color" type="Color">$primary</Var>
        <Var name="art-active-bg-color" type="Color">#ffffff</Var>
        <Var name="art-active-border-color" type="Color">#c8d7df</Var>

        <!-- Atlantic footer with warm coral highlights. -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">$gray-900</Var>
        <Var name="footer-inverse-color" type="Color">#ffad99</Var>
        <Var name="footer-inverse-color-muted" type="Color">#c8d7df</Var>
    </Vars>
</Theme>
