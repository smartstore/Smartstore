<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Blue" description="A signature all-blue header, crisp white product surfaces and warm orange actions. Soft blue details and a deep navy footer give this classic a clear, contemporary feel." author="SmartStore AG" version="1.0">
    <Vars>
        <!-- Signature blue, warm orange actions and recognizable status colors. -->
        <Var name="blue" type="Color">#1459ad</Var>
        <Var name="primary" type="Color">#b94b0b</Var>
        <Var name="secondary" type="Color">#24558b</Var>
        <Var name="success" type="Color">#28764d</Var>
        <Var name="danger" type="Color">#bd354c</Var>
        <Var name="warning" type="Color">#95620d</Var>
        <Var name="info" type="Color">#226d9b</Var>
        <Var name="link-color" type="Color">#1459ad</Var>
        <Var name="btn-secondary-bg" type="Color">#edf3fb</Var>
        <Var name="body-bg" type="Color">#ffffff</Var>
        <Var name="site-bg" type="Color">#ffffff</Var>
        <Var name="body-color" type="Color">#2e3e52</Var>
        <Var name="body-secondary-color" type="Color">#607086</Var>
        <Var name="headings-color" type="String">#172f4e</Var>

        <!-- One continuous blue header, from the service bar through the navigation. -->
        <Var name="header-bg" type="Color">$blue</Var>
        <Var name="menubar-bg" type="Color">$blue</Var>
        <Var name="shopbar-bg" type="Color">$blue</Var>
        <Var name="megamenu-bg" type="Color">$blue</Var>
        <Var name="inverse-menubar" type="Boolean">true</Var>
        <Var name="inverse-shopbar" type="Boolean">true</Var>
        <Var name="inverse-navbar" type="Boolean">true</Var>
        <Var name="menubar-inverse-color" type="Color">#e9f2ff</Var>
        <Var name="shopbar-inverse-color" type="Color">#ffffff</Var>
        <Var name="megamenu-inverse-color" type="Color">#ffffff</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-heading-color" type="Color">$blue</Var>
        <Var name="megamenu-subitem-color" type="Color">#607086</Var>
        <Var name="megamenu-text-color" type="Color">$body-color</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- A clear white search field, with a quiet blue focus ring. -->
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-pill" type="Boolean">true</Var>
        <Var name="searchbox-bg-1" type="Color">#f4f8ff</Var>
        <Var name="searchbox-bg-2" type="Color">#ffffff</Var>
        <Var name="searchbox-bg-mobile" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-color-1" type="Color">#172f4e</Var>
        <Var name="searchbox-color-2" type="Color">#172f4e</Var>
        <Var name="searchbox-border-1" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-border-2" type="Color">#a8cdff</Var>
        <Var name="searchbox-border-mobile" type="Color">$searchbox-border-1</Var>
        <Var name="searchbox-outline-color" type="Color">#a8cdff</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$blue</Var>

        <!-- Restrained rounding and pale supporting surfaces keep products in focus. -->
        <Var name="border-radius" type="String">0.5rem</Var>
        <Var name="border-radius-sm" type="String">0.25rem</Var>
        <Var name="border-radius-lg" type="String">0.75rem</Var>
        <Var name="border-radius-xl" type="String">1rem</Var>
        <Var name="border-radius-xxl" type="String">1.5rem</Var>
        <Var name="card-bg" type="Color">#ffffff</Var>
        <Var name="card-cap-bg" type="Color">#f0f5fc</Var>
        <Var name="card-border-color" type="Color">#dce5f0</Var>
        <Var name="dropdown-bg" type="Color">#ffffff</Var>
        <Var name="dropdown-link-color" type="Color">$body-color</Var>
        <Var name="dropdown-link-hover-color" type="Color">$blue</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#edf3fb</Var>
        <Var name="nav-tabs-active-link-color" type="Color">$blue</Var>
        <Var name="product-price-color" type="Color">#172f4e</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#f0f5fc</Var>
        <Var name="register-box-bg" type="Color">#f0f5fc</Var>
        <Var name="cart-footer-bg" type="Color">#f0f5fc</Var>
        <Var name="offcanvas-cart-footer" type="Color">#f0f5fc</Var>
        <Var name="costep-progress-color" type="Color">$primary</Var>
        <Var name="art-active-bg-color" type="Color">#ffffff</Var>
        <Var name="art-active-border-color" type="Color">#cad9eb</Var>

        <!-- A deep blue footer with readable links and a distinct hover accent. -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#102c50</Var>
        <Var name="footer-inverse-color" type="Color">#ffffff</Var>
        <Var name="footer-inverse-color-muted" type="Color">#bdcee3</Var>
        <Var name="footer-social-color" type="Color">#bdcee3</Var>
        <Var name="footer-social-bg" type="Color">transparent</Var>
    </Vars>
</Theme>
