@using Smartstore.Web.Theming

@model IDictionary<string, object>

@addTagHelper Smartstore.Web.TagHelpers.Admin.*, Smartstore.Web.Common 

@{
    Layout = null;
}

<tabstrip id="theme-flex-edit" sm-nav-style="Material" class="theme-edit">
    <tab sm-title="@T("Common.General")" sm-selected="true">
        <div class="adminContent">
            @{
                await ThemeVarEditorAsync("gray-100", "Grayscale");
                await ThemeVarEditorAsync("gray-200");
                await ThemeVarEditorAsync("gray-300");
                await ThemeVarEditorAsync("gray-400");
                await ThemeVarEditorAsync("gray-500");
                await ThemeVarEditorAsync("gray-600");
                await ThemeVarEditorAsync("gray-700");
                await ThemeVarEditorAsync("gray-800");
                await ThemeVarEditorAsync("gray-900");

                await ThemeVarEditorAsync("red", "Colors");
                await ThemeVarEditorAsync("orange");
                await ThemeVarEditorAsync("yellow");
                await ThemeVarEditorAsync("green");
                await ThemeVarEditorAsync("blue");
                await ThemeVarEditorAsync("bluegrey");
                await ThemeVarEditorAsync("indigo");
                await ThemeVarEditorAsync("teal");
                await ThemeVarEditorAsync("cyan");
                await ThemeVarEditorAsync("pink");
                await ThemeVarEditorAsync("purple");

                await ThemeVarEditorAsync("primary", "Brand Colors");
                await ThemeVarEditorAsync("secondary");
                await ThemeVarEditorAsync("warning");
                await ThemeVarEditorAsync("danger");
                await ThemeVarEditorAsync("info");
                await ThemeVarEditorAsync("success");
                await ThemeVarEditorAsync("light");
                await ThemeVarEditorAsync("dark");

                await ThemeVarEditorAsync("boxed", "Layout", T("Admin.ThemeVar.Boxed"));

                await ThemeVarEditorAsync("body-bg", "Site Colors");
                await ThemeVarEditorAsync("site-bg");
                await ThemeVarEditorAsync("body-color");
                await ThemeVarEditorAsync("yiq-text-dark");
                await ThemeVarEditorAsync("yiq-text-light");
                await ThemeVarEditorAsync("body-secondary-color");
                await ThemeVarEditorAsync("body-tertiary-color");
                await ThemeVarEditorAsync("link-color");
                await ThemeVarEditorAsync("btn-secondary-bg", "");

                await ThemeVarEditorAsync("border-radius", "Borders");
                await ThemeVarEditorAsync("border-radius-sm");
                await ThemeVarEditorAsync("border-radius-lg");
                await ThemeVarEditorAsync("border-radius-xl");
                await ThemeVarEditorAsync("border-radius-xxl");
            }
        </div>
    </tab>
    <tab sm-title="@T("Admin.Themes.Fonts")">
        <div class="adminContent">
            @{
                await ThemeVarEditorAsync("font-family-sans-serif", "Typo");
                await ThemeVarEditorAsync("font-family-monospace");
                await ThemeVarEditorAsync("font-size-base");
                await ThemeVarEditorAsync("font-size-lg");
                await ThemeVarEditorAsync("font-size-sm");
                await ThemeVarEditorAsync("font-size-xs");
                await ThemeVarEditorAsync("font-weight-light");
                await ThemeVarEditorAsync("font-weight-normal");
                await ThemeVarEditorAsync("font-weight-medium");
                await ThemeVarEditorAsync("font-weight-bold");

                await ThemeVarEditorAsync("headings-font-family", "Headings");
                await ThemeVarEditorAsync("headings-font-weight");
                await ThemeVarEditorAsync("headings-line-height");
                await ThemeVarEditorAsync("headings-color");
                await ThemeVarEditorAsync("lead-font-weight");

                await ThemeVarEditorAsync("h1-font-size", "Heading Sizes");
                await ThemeVarEditorAsync("h2-font-size");
                await ThemeVarEditorAsync("h3-font-size");
                await ThemeVarEditorAsync("h4-font-size");
                await ThemeVarEditorAsync("h5-font-size");
                await ThemeVarEditorAsync("h6-font-size");

                await ThemeVarEditorAsync("prose-font-size", "Prose");
                await ThemeVarEditorAsync("prose-line-height");
                await ThemeVarEditorAsync("prose-headings-lg-font-weight");
                await ThemeVarEditorAsync("prose-headings-sm-font-weight");
            }

            <div class="adminRow">
                <div class="admin-config-group">
                    <div class="title">Google Fonts</div>
                </div>
            </div>

            <div class="adminRow">
                <div class="alert alert-info w-100 mb-0 alert-dismissible fade show">
                    <button type="button" class="btn-close" data-dismiss="alert" aria-label="Close"></button>
                    @Html.Raw(T("Admin.Theme.GoogleFonts.Hint"))
                </div>
            </div>

            <div class="adminRow">
                <div class="alert alert-warning w-100">
                    @Html.Raw(T("Admin.Theme.GoogleFonts.Gdpr.Hint"))
                </div>
            </div>

            @{
                await ThemeVarEditorAsync("google-font-1");
                await ThemeVarEditorAsync("google-font-2");
                await ThemeVarEditorAsync("google-font-3");
            }
        </div>
    </tab>
    <tab sm-title="@T("Admin.Themes.Sections")">
        <div class="adminContent">
            @{
                ThemeVarEditor("header-bg", "Header");
                ThemeVarEditor("header-color");
                ThemeVarEditor("shopbar-label");
                ThemeVarEditor("header-color-muted");

                ThemeVarEditor("inverse-menubar", "");
                ThemeVarEditor("menubar-bg");
                ThemeVarEditor("menubar-color");
                ThemeVarEditor("menubar-inverse-color");

                ThemeVarEditor("inverse-shopbar", "");
                ThemeVarEditor("shopbar-bg");
                ThemeVarEditor("shopbar-color");
                ThemeVarEditor("shopbar-inverse-color");

                ThemeVarEditor("inverse-navbar", "");
                ThemeVarEditor("megamenu-bg");
                ThemeVarEditor("megamenu-color");
                ThemeVarEditor("megamenu-inverse-color");
                ThemeVarEditor("megamenu-line-height");

                ThemeVarEditor("megamenu-dropdown-bg");
                ThemeVarEditor("megamenu-heading-color");
                ThemeVarEditor("megamenu-subitem-color");
                ThemeVarEditor("megamenu-text-color");
                ThemeVarEditor("megamenu-rotator-bg");

                ThemeVarEditor("searchbox-pill", "Searchbox");
                ThemeVarEditor("searchbox-shadow");
                ThemeVarEditor("searchbox-bg-1");
                ThemeVarEditor("searchbox-bg-2");
                ThemeVarEditor("searchbox-bg-mobile");
                ThemeVarEditor("searchbox-color-1");
                ThemeVarEditor("searchbox-color-2");
                ThemeVarEditor("searchbox-border-1");

                ThemeVarEditor("searchbox-outline-width");
                ThemeVarEditor("searchbox-outline-color");
                ThemeVarEditor("searchbox-border-mobile");
                ThemeVarEditor("searchbox-hit-tag-color");

                ThemeVarEditor("inverse-footer", "Footer");
                ThemeVarEditor("footer-bg");
                ThemeVarEditor("footer-color");
                ThemeVarEditor("footer-color-muted");
                ThemeVarEditor("footer-inverse-color");
                ThemeVarEditor("footer-inverse-color-muted");
                ThemeVarEditor("footer-social-bg");
                ThemeVarEditor("footer-social-color");
            }
        </div>
    </tab>
    <tab sm-title="@T("Admin.Themes.Components")">
        <div class="adminContent">
            @{
                await ThemeVarEditorAsync("card-border-radius", "Cards");
                await ThemeVarEditorAsync("card-border-color");
                await ThemeVarEditorAsync("card-cap-bg");
                await ThemeVarEditorAsync("card-bg");

                await ThemeVarEditorAsync("dropdown-bg", "Dropdowns");
                await ThemeVarEditorAsync("dropdown-color");
                await ThemeVarEditorAsync("dropdown-border-color");
                await ThemeVarEditorAsync("dropdown-border-radius");
                await ThemeVarEditorAsync("dropdown-divider-bg");
                await ThemeVarEditorAsync("dropdown-box-shadow");
                await ThemeVarEditorAsync("dropdown-link-color");
                await ThemeVarEditorAsync("dropdown-link-hover-color");
                await ThemeVarEditorAsync("dropdown-link-hover-bg");

                await ThemeVarEditorAsync("table-bg", "Tables");
                await ThemeVarEditorAsync("table-accent-bg");
                await ThemeVarEditorAsync("table-hover-bg");
                await ThemeVarEditorAsync("table-active-bg");
                await ThemeVarEditorAsync("table-border-color");
            }
        </div>
    </tab>
    <tab sm-title="@T("Admin.Themes.Misc")">
        <div class="adminContent">
            @{
                await ThemeVarEditorAsync("nav-tabs-active-link-color");
                await ThemeVarEditorAsync("product-price-color");
                await ThemeVarEditorAsync("product-detail-addtocart-box-bg");
                await ThemeVarEditorAsync("register-box-bg");
                await ThemeVarEditorAsync("cart-footer-bg");
                await ThemeVarEditorAsync("costep-progress-color", null, T("Admin.ThemeVar.CostepPogressColor"));
                await ThemeVarEditorAsync("offcanvas-cart-footer");
                await ThemeVarEditorAsync("art-active-bg-color", null, T("Admin.ThemeVar.ArtActiveBgColor"));
                await ThemeVarEditorAsync("art-active-border-color", null, T("Admin.ThemeVar.ArtActiveBorderColor"));
                await ThemeVarEditorAsync("enable-alert-icons");
            }
        </div>
    </tab>
</tabstrip>

@{
    async Task ThemeVarEditorAsync(string varName, string groupName = null, string helpText = null)
    {
        var themeVar = Display.GetThemeDescriptor().Variables[varName];

        if (groupName != null)
        {
            <div class="adminRow">
                <div class="admin-config-group">
                    <div class="title">@groupName</div>
                </div>
            </div>
        }

        <div class="adminRow">
            <div class="adminTitle">
                @Html.ThemeVarLabel(themeVar, helpText)
            </div>
            <div class="adminData">
                @Html.ThemeVarEditor(themeVar, Model[varName])
            </div>
            <div class="d-none d-xl-flex align-items-center">
                @await Html.ThemeVarChainInfoAsync(themeVar)
            </div>
        </div>
    }
}
