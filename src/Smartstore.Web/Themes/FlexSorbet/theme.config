<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Sorbet" description="A fresh editorial palette of aubergine, lime and mint on warm porcelain, with expressive serif headings." author="SmartStore AG" version="1.0">
    <Vars>
        <!-- Warm neutrals with a subtle plum undertone. -->
        <Var name="gray-100" type="Color">#f6f3f0</Var>
        <Var name="gray-200" type="Color">#ebe5e4</Var>
        <Var name="gray-300" type="Color">#d8cecf</Var>
        <Var name="gray-400" type="Color">#bfb1b7</Var>
        <Var name="gray-500" type="Color">#96858e</Var>
        <Var name="gray-600" type="Color">#74636e</Var>
        <Var name="gray-700" type="Color">#5c4956</Var>
        <Var name="gray-800" type="Color">#3f2c3b</Var>
        <Var name="gray-900" type="Color">#291a28</Var>

        <!-- Aubergine actions, botanical secondary accents, familiar status colors. -->
        <Var name="primary" type="Color">#542448</Var>
        <Var name="secondary" type="Color">#29685f</Var>
        <Var name="success" type="Color">#247557</Var>
        <Var name="danger" type="Color">#b73550</Var>
        <Var name="warning" type="Color">#efb64b</Var>
        <Var name="info" type="Color">#316e8a</Var>
        <Var name="light" type="Color">#f6f3f0</Var>
        <Var name="dark" type="Color">#291a28</Var>

        <!-- Open canvas; product photography keeps a neutral white surface. -->
        <Var name="boxed" type="Boolean">false</Var>
        <Var name="site-bg" type="Color">#faf8f4</Var>
        <Var name="body-bg" type="Color">#faf8f4</Var>
        <Var name="body-color" type="Color">$gray-800</Var>
        <Var name="body-secondary-color" type="Color">$gray-600</Var>
        <Var name="body-tertiary-color" type="Color">$gray-500</Var>
        <Var name="yiq-text-dark" type="Color">$gray-900</Var>
        <Var name="link-color" type="Color">$secondary</Var>
        <Var name="btn-secondary-bg" type="Color">#e3f2eb</Var>

        <!-- System fonts: editorial contrast without additional font files or requests. -->
        <Var name="font-family-sans-serif" type="String">"Trebuchet MS", "Segoe UI", Arial, sans-serif</Var>
        <Var name="font-size-base" type="String">1rem</Var>
        <Var name="font-size-lg" type="String">1.125rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="font-weight-medium" type="String">600</Var>
        <Var name="headings-font-family" type="String">Georgia, "Times New Roman", serif</Var>
        <Var name="headings-font-weight" type="String">400</Var>
        <Var name="headings-line-height" type="String">1.15</Var>
        <Var name="headings-color" type="String">$primary</Var>
        <Var name="h1-font-size" type="String">2.75rem</Var>
        <Var name="h2-font-size" type="String">2.125rem</Var>
        <Var name="h3-font-size" type="String">1.625rem</Var>
        <Var name="h4-font-size" type="String">1.375rem</Var>
        <Var name="prose-font-size" type="String">1.0625rem</Var>
        <Var name="prose-line-height" type="String">1.7</Var>
        <Var name="prose-headings-lg-font-weight" type="String">400</Var>
        <Var name="prose-headings-sm-font-weight" type="String">400</Var>
        <Var name="badge-content-shift" type="String">0px</Var>

        <!-- Soft geometry, with deliberately quieter small controls. -->
        <Var name="border-radius" type="String">0.625rem</Var>
        <Var name="border-radius-sm" type="String">0.375rem</Var>
        <Var name="border-radius-lg" type="String">1rem</Var>
        <Var name="border-radius-xl" type="String">1.5rem</Var>
        <Var name="border-radius-xxl" type="String">2rem</Var>

        <!-- Lime service bar, porcelain shopbar, aubergine navigation. -->
        <Var name="header-bg" type="Color">$body-bg</Var>
        <Var name="menubar-bg" type="Color">#d8f36a</Var>
        <Var name="menubar-color" type="Color">$gray-900</Var>
        <Var name="shopbar-bg" type="Color">$body-bg</Var>
        <Var name="shopbar-color" type="Color">$primary</Var>
        <Var name="inverse-menubar" type="Boolean">false</Var>
        <Var name="inverse-shopbar" type="Boolean">false</Var>
        <Var name="inverse-navbar" type="Boolean">true</Var>
        <Var name="megamenu-bg" type="Color">$primary</Var>
        <Var name="megamenu-inverse-color" type="Color">#faf8f4</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#fffdf9</Var>
        <Var name="megamenu-heading-color" type="Color">$primary</Var>
        <Var name="megamenu-subitem-color" type="Color">$gray-600</Var>
        <Var name="megamenu-text-color" type="Color">$body-color</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- Mint search surface with a clear botanical focus ring. -->
        <Var name="searchbox-pill" type="Boolean">true</Var>
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-color" type="Color">$secondary</Var>
        <Var name="searchbox-bg-1" type="Color">#e3f2eb</Var>
        <Var name="searchbox-bg-2" type="Color">#ffffff</Var>
        <Var name="searchbox-bg-mobile" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-color-1" type="Color">$gray-900</Var>
        <Var name="searchbox-color-2" type="Color">$gray-900</Var>
        <Var name="searchbox-border-1" type="Color">#b8d7c9</Var>
        <Var name="searchbox-border-2" type="Color">$secondary</Var>
        <Var name="searchbox-border-mobile" type="Color">$searchbox-border-1</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$primary</Var>

        <!-- Quiet surfaces and a mint purchase panel. -->
        <Var name="card-bg" type="Color">#ffffff</Var>
        <Var name="card-cap-bg" type="Color">#f2ecef</Var>
        <Var name="card-border-color" type="Color">$gray-200</Var>
        <Var name="dropdown-bg" type="Color">#fffdf9</Var>
        <Var name="dropdown-link-color" type="Color">$body-color</Var>
        <Var name="dropdown-link-hover-color" type="Color">$primary</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#e3f2eb</Var>
        <Var name="nav-tabs-active-link-color" type="Color">$primary</Var>
        <Var name="product-price-color" type="Color">$primary</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#e3f2eb</Var>
        <Var name="register-box-bg" type="Color">#f2ecef</Var>
        <Var name="cart-footer-bg" type="Color">#e3f2eb</Var>
        <Var name="costep-progress-color" type="Color">$secondary</Var>
        <Var name="art-active-bg-color" type="Color">#ffffff</Var>
        <Var name="art-active-border-color" type="Color">#b8d7c9</Var>

        <!-- A deep plum closing section with lime highlights. -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#291a28</Var>
        <Var name="footer-inverse-color" type="Color">#d8f36a</Var>
        <Var name="footer-inverse-color-muted" type="Color">#d4c7d0</Var>
    </Vars>
</Theme>
