<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Black" description="A distinctive boxed storefront with slim Barlow Semi Condensed typography, a black service bar and layered graphite navigation. Crisp white content and soft neutral panels create a restrained, contemporary contrast." author="SmartStore AG" version="1.1">
    <Vars>
        <!-- Boxed composition and a crisp monochrome palette. -->
        <Var name="boxed" type="Boolean">true</Var>
        <Var name="site-bg" type="Color">#e9e9e7</Var>
        <Var name="body-bg" type="Color">#ffffff</Var>
        <Var name="body-color" type="Color">#363636</Var>
        <Var name="body-secondary-color" type="Color">#666666</Var>
        <Var name="headings-color" type="String">#202020</Var>
        <Var name="primary" type="Color">#353535</Var>
        <Var name="secondary" type="Color">#64615c</Var>
        <Var name="link-color" type="Color">#363636</Var>
        <Var name="btn-secondary-bg" type="Color">#f1f1ef</Var>
        <Var name="success" type="Color">#28764d</Var>
        <Var name="danger" type="Color">#b73549</Var>
        <Var name="warning" type="Color">#95620d</Var>
        <Var name="info" type="Color">#356d8c</Var>

        <!-- Locally hosted condensed typography with native text and heading weights. -->
        <Var name="font-family-sans-serif" type="String">"Barlow Semi Condensed", "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="font-size-base" type="String">1rem</Var>
        <Var name="font-size-lg" type="String">1.25rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="badge-content-shift" type="String">0px</Var>

        <!-- Keep the compact geometry of the original boxed theme. -->
        <Var name="border-radius" type="String">4px</Var>
        <Var name="border-radius-sm" type="String">3px</Var>
        <Var name="border-radius-lg" type="String">6px</Var>
        <Var name="border-radius-xl" type="String">8px</Var>
        <Var name="border-radius-xxl" type="String">12px</Var>

        <!-- The black service strip anchors two quieter graphite header surfaces. -->
        <Var name="header-bg" type="Color">#111</Var>
        <Var name="menubar-bg" type="Color">#111</Var>
        <Var name="shopbar-bg" type="Color">#292929</Var>
        <Var name="megamenu-bg" type="Color">#363636</Var>
        <Var name="inverse-menubar" type="Boolean">true</Var>
        <Var name="inverse-shopbar" type="Boolean">true</Var>
        <Var name="inverse-navbar" type="Boolean">true</Var>
        <Var name="menubar-inverse-color" type="Color">#e5e5e5</Var>
        <Var name="shopbar-inverse-color" type="Color">#ffffff</Var>
        <Var name="megamenu-inverse-color" type="Color">#f4f4f4</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-heading-color" type="Color">#202020</Var>
        <Var name="megamenu-subitem-color" type="Color">#666666</Var>
        <Var name="megamenu-text-color" type="Color">$body-color</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- A dark search field integrates with the graphite header. -->
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-pill" type="Boolean">false</Var>
        <Var name="searchbox-bg-1" type="Color">$gray-700</Var>
        <Var name="searchbox-color-1" type="Color">#ffffff</Var>
        <Var name="searchbox-bg-2" type="Color">#ffffff</Var>
        <Var name="searchbox-color-2" type="Color">#202020</Var>
        <Var name="searchbox-border-1" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-border-2" type="Color">#a9a9a5</Var>
        <Var name="searchbox-outline-color" type="Color">#a9a9a5</Var>
        <Var name="searchbox-bg-mobile" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-border-mobile" type="Color">$searchbox-border-1</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$primary</Var>

        <!-- Light neutral panels and restrained contrast for product content. -->
        <Var name="card-bg" type="Color">#ffffff</Var>
        <Var name="card-cap-bg" type="Color">#f4f4f2</Var>
        <Var name="card-border-color" type="Color">#dededb</Var>
        <Var name="dropdown-bg" type="Color">#ffffff</Var>
        <Var name="dropdown-border-color" type="Color">#dededb</Var>
        <Var name="dropdown-link-color" type="Color">#363636</Var>
        <Var name="dropdown-link-hover-color" type="Color">#111111</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#eeeeeb</Var>
        <Var name="dropdown-border-radius" type="Color">$border-radius</Var>
        <Var name="nav-tabs-active-link-color" type="Color">#202020</Var>
        <Var name="product-price-color" type="Color">#202020</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#f4f4f2</Var>
        <Var name="register-box-bg" type="Color">#f4f4f2</Var>
        <Var name="cart-footer-bg" type="Color">#f4f4f2</Var>
        <!-- A charcoal receipt in the off-canvas panel, matching the page footer. -->
        <Var name="offcanvas-cart-footer" type="Color">#222222</Var>
        <Var name="costep-progress-color" type="Color">$primary</Var>
        <Var name="art-active-bg-color" type="Color">#ffffff</Var>
        <Var name="art-active-border-color" type="Color">#ccccca</Var>

        <!-- A charcoal footer with clear, understated link states. -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#222222</Var>
        <Var name="footer-inverse-color" type="Color">#f5f5f3</Var>
        <Var name="footer-inverse-color-muted" type="Color">#bdbdb8</Var>
        <Var name="footer-social-color" type="Color">#bdbdb8</Var>
        <Var name="footer-social-bg" type="Color">transparent</Var>
    </Vars>
</Theme>
