<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Afterglow" description="Graphite nights with electric mint, soft orchid and apricot accents. A calm dark canvas with luminous details." author="SmartStore AG" version="1.0">
    <Vars>
        <!-- Dark surfaces rising toward clear, cool text. -->
        <Var name="gray-100" type="Color">#171e2b</Var>
        <Var name="gray-200" type="Color">#222d3d</Var>
        <Var name="gray-300" type="Color">#354359</Var>
        <Var name="gray-400" type="Color">#53637b</Var>
        <Var name="gray-500" type="Color">#8291a9</Var>
        <Var name="gray-600" type="Color">#a6b3c7</Var>
        <Var name="gray-700" type="Color">#c5cfe0</Var>
        <Var name="gray-800" type="Color">#dce4ef</Var>
        <Var name="gray-900" type="Color">#f2f6fc</Var>

        <!-- Electric mint, orchid and apricot accents. -->
        <Var name="primary" type="Color">#6cf0c2</Var>
        <Var name="secondary" type="Color">#c9a7ff</Var>
        <Var name="success" type="Color">#7de2a5</Var>
        <Var name="danger" type="Color">#ff889e</Var>
        <Var name="warning" type="Color">#ffc482</Var>
        <Var name="info" type="Color">#85d5ff</Var>
        <Var name="light" type="Color">#dce4ef</Var>
        <Var name="dark" type="Color">#0e1420</Var>

        <!-- A graphite canvas with explicit contrast colors. -->
        <Var name="boxed" type="Boolean">false</Var>
        <Var name="site-bg" type="Color">#0e1420</Var>
        <Var name="body-bg" type="Color">#111824</Var>
        <Var name="body-color" type="Color">#dce4ef</Var>
        <Var name="body-secondary-color" type="Color">#a6b3c7</Var>
        <Var name="body-tertiary-color" type="Color">#8291a9</Var>
        <Var name="yiq-text-dark" type="Color">#101925</Var>
        <Var name="link-color" type="Color">$primary</Var>
        <Var name="btn-secondary-bg" type="Color">#222d3d</Var>

        <!-- Calm system typography without external font requests. -->
        <Var name="font-family-sans-serif" type="String">"Segoe UI", "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="font-size-base" type="String">1rem</Var>
        <Var name="font-size-lg" type="String">1.125rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="font-weight-medium" type="String">600</Var>
        <Var name="headings-font-family" type="String">"Segoe UI", "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="headings-font-weight" type="String">600</Var>
        <Var name="headings-line-height" type="String">1.15</Var>
        <Var name="headings-color" type="String">#f2f6fc</Var>
        <Var name="h1-font-size" type="String">2.5rem</Var>
        <Var name="h2-font-size" type="String">2rem</Var>
        <Var name="h3-font-size" type="String">1.5rem</Var>
        <Var name="h4-font-size" type="String">1.25rem</Var>
        <Var name="prose-font-size" type="String">1.0625rem</Var>
        <Var name="prose-line-height" type="String">1.65</Var>
        <Var name="prose-headings-lg-font-weight" type="String">600</Var>
        <Var name="prose-headings-sm-font-weight" type="String">600</Var>

        <!-- Soft geometry for panels and controls. -->
        <Var name="border-radius" type="String">0.625rem</Var>
        <Var name="border-radius-sm" type="String">0.375rem</Var>
        <Var name="border-radius-lg" type="String">1rem</Var>
        <Var name="border-radius-xl" type="String">1.375rem</Var>
        <Var name="border-radius-xxl" type="String">1.75rem</Var>

        <!-- An orchid service strip above the dark masthead. -->
        <Var name="header-bg" type="Color">#0e1420</Var>
        <Var name="header-color" type="Color">#f2f6fc</Var>
        <Var name="header-color-muted" type="Color">#a6b3c7</Var>
        <Var name="menubar-bg" type="Color">#222033</Var>
        <Var name="menubar-color" type="Color">#c9a7ff</Var>
        <Var name="shopbar-bg" type="Color">#0e1420</Var>
        <Var name="inverse-menubar" type="Boolean">false</Var>
        <Var name="inverse-shopbar" type="Boolean">true</Var>
        <Var name="shopbar-inverse-color" type="Color">#f2f6fc</Var>
        <Var name="inverse-navbar" type="Boolean">true</Var>
        <Var name="megamenu-bg" type="Color">#171e2b</Var>
        <Var name="megamenu-color" type="Color">#dce4ef</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#171e2b</Var>
        <Var name="megamenu-heading-color" type="Color">$primary</Var>
        <Var name="megamenu-subitem-color" type="Color">#a6b3c7</Var>
        <Var name="megamenu-text-color" type="Color">#dce4ef</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- Raised search surface with a mint focus ring. -->
        <Var name="searchbox-pill" type="Boolean">true</Var>
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-color" type="Color">$primary</Var>
        <Var name="searchbox-bg-1" type="Color">#222d3d</Var>
        <Var name="searchbox-bg-2" type="Color">#29374a</Var>
        <Var name="searchbox-bg-mobile" type="Color">$searchbox-bg-1</Var>
        <Var name="searchbox-color-1" type="Color">#f2f6fc</Var>
        <Var name="searchbox-color-2" type="Color">#f2f6fc</Var>
        <Var name="searchbox-border-1" type="Color">#354359</Var>
        <Var name="searchbox-border-2" type="Color">$primary</Var>
        <Var name="searchbox-border-mobile" type="Color">$searchbox-border-1</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$secondary</Var>

        <!-- Layered surfaces with botanical purchase panels. -->
        <Var name="card-bg" type="Color">#171e2b</Var>
        <Var name="card-cap-bg" type="Color">#222d3d</Var>
        <Var name="card-border-color" type="Color">#354359</Var>
        <Var name="dropdown-bg" type="Color">#171e2b</Var>
        <Var name="dropdown-link-color" type="Color">#dce4ef</Var>
        <Var name="dropdown-link-hover-color" type="Color">$primary</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#26384a</Var>
        <Var name="nav-tabs-active-link-color" type="Color">$primary</Var>
        <Var name="product-price-color" type="Color">#f2f6fc</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#1b3031</Var>
        <Var name="register-box-bg" type="Color">#252237</Var>
        <Var name="cart-footer-bg" type="Color">#1b3031</Var>
        <Var name="costep-progress-color" type="Color">$primary</Var>
        <Var name="art-active-bg-color" type="Color">#171e2b</Var>
        <Var name="art-active-border-color" type="Color">#53637b</Var>

        <!-- A deep closing section with mint highlights. -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#0b101a</Var>
        <Var name="footer-inverse-color" type="Color">$primary</Var>
        <Var name="footer-inverse-color-muted" type="Color">#a6b3c7</Var>
        <Var name="yiq-text-light" type="Color">#f2f6fc</Var>
        <Var name="megamenu-inverse-color" type="Color">#dce4ef</Var>
        <Var name="megamenu-rotator-bg" type="Color">rgba(#171e2b, 0.96)</Var>
        <Var name="dropdown-color" type="Color">$body-color</Var>
        <Var name="dropdown-border-color" type="Color">$gray-300</Var>
        <Var name="dropdown-divider-bg" type="Color">$gray-300</Var>
        <Var name="table-accent-bg" type="Color">rgba(#fff, 0.025)</Var>
        <Var name="table-hover-bg" type="Color">rgba(#fff, 0.05)</Var>
        <Var name="table-border-color" type="Color">$gray-300</Var>
    </Vars>
</Theme>
