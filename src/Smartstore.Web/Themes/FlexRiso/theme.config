<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Riso" description="Inspired by risograph prints: cobalt ink, fluorescent pink and sunflower yellow on bright white paper. Condensed DIN-style headings and playful off-register accents." author="SmartStore AG" version="1.0">
    <Vars>
        <!-- Cool neutrals tinted with a drop of printing ink. -->
        <Var name="gray-100" type="Color">#f5f6fb</Var>
        <Var name="gray-200" type="Color">#eaecf5</Var>
        <Var name="gray-300" type="Color">#d9dcea</Var>
        <Var name="gray-400" type="Color">#b8bcd2</Var>
        <Var name="gray-500" type="Color">#868aa6</Var>
        <Var name="gray-600" type="Color">#5e6382</Var>
        <Var name="gray-700" type="Color">#444865</Var>
        <Var name="gray-800" type="Color">#2c2f4a</Var>
        <Var name="gray-900" type="Color">#16182f</Var>

        <!-- The riso drum set: three spot inks plus their overprints. -->
        <Var name="blue" type="Color">#1f4ed8</Var>
        <Var name="pink" type="Color">#ff48b0</Var>
        <Var name="yellow" type="Color">#ffd23f</Var>
        <Var name="purple" type="Color">#6b3fd4</Var>
        <Var name="orange" type="Color">#ff6c2f</Var>
        <Var name="teal" type="Color">#00777d</Var>
        <Var name="green" type="Color">#0b7f4d</Var>
        <Var name="red" type="Color">#d2283c</Var>

        <!-- Cobalt actions, magenta highlights, sunflower warnings. -->
        <Var name="primary" type="Color">$blue</Var>
        <Var name="secondary" type="Color">#d1157a</Var>
        <Var name="success" type="Color">$green</Var>
        <Var name="danger" type="Color">$red</Var>
        <Var name="warning" type="Color">$yellow</Var>
        <Var name="info" type="Color">$teal</Var>
        <Var name="light" type="Color">$gray-100</Var>
        <Var name="dark" type="Color">$gray-900</Var>

        <!-- Plain white paper everywhere, so product photos never sit in boxes. -->
        <Var name="boxed" type="Boolean">false</Var>
        <Var name="site-bg" type="Color">#ffffff</Var>
        <Var name="body-bg" type="Color">#ffffff</Var>
        <Var name="body-color" type="Color">$gray-800</Var>
        <Var name="body-secondary-color" type="Color">$gray-600</Var>
        <Var name="body-tertiary-color" type="Color">$gray-500</Var>
        <Var name="yiq-text-dark" type="Color">$gray-900</Var>
        <Var name="link-color" type="Color">$primary</Var>
        <Var name="btn-secondary-bg" type="Color">#ffffff</Var>

        <!-- Crisp system text, condensed DIN-style display type (Bahnschrift on Windows, DIN Alternate on macOS). -->
        <Var name="font-family-sans-serif" type="String">"Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="font-size-base" type="String">1rem</Var>
        <Var name="font-size-lg" type="String">1.125rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="font-weight-medium" type="String">600</Var>
        <Var name="headings-font-family" type="String">Bahnschrift, "DIN Alternate", "DIN Next", "D-DIN", "Roboto Condensed", sans-serif-condensed, "Arial Narrow", sans-serif</Var>
        <Var name="headings-font-weight" type="String">600</Var>
        <Var name="headings-line-height" type="String">1.1</Var>
        <Var name="headings-color" type="String">$gray-900</Var>
        <Var name="h1-font-size" type="String">2.625rem</Var>
        <Var name="h2-font-size" type="String">2rem</Var>
        <Var name="h3-font-size" type="String">1.5rem</Var>
        <Var name="h4-font-size" type="String">1.25rem</Var>
        <Var name="prose-font-size" type="String">1.0625rem</Var>
        <Var name="prose-line-height" type="String">1.65</Var>
        <Var name="prose-headings-lg-font-weight" type="String">600</Var>
        <Var name="prose-headings-sm-font-weight" type="String">600</Var>
        <Var name="badge-content-shift" type="String">0px</Var>

        <!-- Print-shop geometry: tight corners, nothing pillowy. -->
        <Var name="border-radius" type="String">0.25rem</Var>
        <Var name="border-radius-sm" type="String">0.1875rem</Var>
        <Var name="border-radius-lg" type="String">0.375rem</Var>
        <Var name="border-radius-xl" type="String">0.5rem</Var>
        <Var name="border-radius-xxl" type="String">0.75rem</Var>

        <!-- An all-white header; the colour comes from the registration strip and the ink rule. -->
        <Var name="header-bg" type="Color">#ffffff</Var>
        <Var name="header-color" type="Color">$gray-900</Var>
        <Var name="header-color-muted" type="Color">$gray-600</Var>
        <Var name="inverse-menubar" type="Boolean">false</Var>
        <Var name="inverse-shopbar" type="Boolean">false</Var>
        <Var name="inverse-navbar" type="Boolean">false</Var>
        <Var name="menubar-bg" type="Color">#ffffff</Var>
        <Var name="menubar-color" type="Color">$gray-700</Var>
        <Var name="shopbar-bg" type="Color">#ffffff</Var>
        <Var name="shopbar-color" type="Color">$gray-900</Var>
        <Var name="megamenu-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-color" type="Color">$gray-900</Var>
        <Var name="header-selected-color" type="Color">$pink</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-heading-color" type="Color">$primary</Var>
        <Var name="megamenu-subitem-color" type="Color">$gray-600</Var>
        <Var name="megamenu-text-color" type="Color">$body-color</Var>
        <Var name="megamenu-rotator-bg" type="Color">rgba(#fff, 0.94)</Var>
        <Var name="shopbar-label" type="Select#brand-colors">secondary</Var>

        <!-- Squared search field that inks up on focus. -->
        <Var name="searchbox-pill" type="Boolean">false</Var>
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-width" type="String">2px</Var>
        <Var name="searchbox-outline-color" type="Color">$pink</Var>
        <Var name="searchbox-bg-1" type="Color">$gray-100</Var>
        <Var name="searchbox-bg-2" type="Color">#ffffff</Var>
        <Var name="searchbox-bg-mobile" type="Color">$gray-100</Var>
        <Var name="searchbox-color-1" type="Color">$gray-900</Var>
        <Var name="searchbox-color-2" type="Color">$gray-900</Var>
        <Var name="searchbox-border-1" type="Color">$gray-200</Var>
        <Var name="searchbox-border-2" type="Color">$gray-900</Var>
        <Var name="searchbox-border-mobile" type="Color">$gray-200</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$secondary</Var>

        <!-- White surfaces with pale sunflower panels where the buying happens. -->
        <Var name="card-bg" type="Color">#ffffff</Var>
        <Var name="card-cap-bg" type="Color">$gray-100</Var>
        <Var name="card-border-color" type="Color">$gray-200</Var>
        <Var name="dropdown-bg" type="Color">#ffffff</Var>
        <Var name="dropdown-border-color" type="Color">$gray-200</Var>
        <Var name="dropdown-link-color" type="Color">$gray-800</Var>
        <Var name="dropdown-link-hover-color" type="Color">$primary</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#eef2fd</Var>
        <Var name="table-border-color" type="Color">$gray-200</Var>
        <Var name="nav-tabs-active-link-color" type="Color">$primary</Var>
        <Var name="product-price-color" type="Color">$secondary</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#fff8db</Var>
        <Var name="register-box-bg" type="Color">#fff0f7</Var>
        <Var name="cart-footer-bg" type="Color">#fff8db</Var>
        <Var name="costep-progress-color" type="Color">$primary</Var>
        <Var name="art-active-bg-color" type="Color">#ffffff</Var>
        <Var name="art-active-border-color" type="Color">rgba(0,0,0, 0)</Var>

        <!-- A cobalt poster to close the page, with sunflower titles. -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">$primary</Var>
        <Var name="footer-inverse-color" type="Color">#ffffff</Var>
        <Var name="footer-inverse-color-muted" type="Color">#d4ddff</Var>
        <Var name="footer-social-color" type="Color">#ffffff</Var>
        <Var name="footer-social-bg" type="Color">transparent</Var>
    </Vars>
</Theme>
