@model ConfigurationModelBase

@{
    Layout = "_ConfigureProvider";
}

@await Component.InvokeAsync("StoreScope")

<widget target-zone="admin_button_toolbar_before">
    <button id="SaveConfigButton" type="submit" name="save" class="btn btn-primary" value="save">
        <icon name="check"  />
        <span>@T("Admin.Common.Save")</span>
    </button>
</widget>

<form asp-action="@Model.PostActionName">
    <div class="adminContent">
        <div class="adminRow">
            <div class="adminTitle">
                <smart-label asp-for="TransactMode" />
            </div>
            <div class="adminData">
                <setting-editor asp-for="TransactMode">
                    <select asp-for="TransactMode" asp-items="ViewBag.TransactModes"></select>
                </setting-editor>
                <span asp-validation-for="TransactMode"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle">
                <smart-label asp-for="AdditionalFee" />
            </div>
            <div class="adminData">
                <setting-editor asp-for="AdditionalFee" additional-for="AdditionalFeePercentage">
                    <amount-or-percent asp-for="AdditionalFee" percentage-for="AdditionalFeePercentage"
                                       unit="@ViewBag.PrimaryStoreCurrencyCode" />
                </setting-editor>
                <span asp-validation-for="AdditionalFee"></span>
                <span asp-validation-for="AdditionalFeePercentage"></span>
            </div>
        </div>
    </div>
</form>